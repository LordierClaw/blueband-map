<template>
  <div class="page">
    <div class="waiting" if="{{ waiting }}">
      <div class="mark"><text class="mark-text">M</text></div>
      <text class="title">BLUEBAND MAP</text>
      <text class="status">ĐANG CHỜ KẾT NỐI…</text>
      <text class="detail">Mở BlueBandMap trên iPhone để kết nối Band 10.</text>
      <text class="version">RPK 0.6.17</text>
    </div>

    <div class="connected" if="{{ connected }}">
      <div class="map-frame" if="{{ mapReady || pendingPublication }}">
        <image class="map" if="{{ mapReady && !streamVisible }}" src="{{ mapPath }}" />
        <image class="map map-pending" if="{{ pendingPublication }}" src="{{ pendingMapPath }}" @complete="mapComplete(pendingMapToken)" @error="mapError(pendingMapToken)" />
        <image class="stream-cell" for="{{ streamImages }}" tid="uri" src="{{ $item.uri }}" style="{{ $item.style }}" @complete="streamImageComplete($item.key, $item.uri)" @error="streamImageError($item.key, $item.uri)" />
        <text class="stream-attribution" if="{{ streamVisible }}">© Vietmap</text>
        <image class="nav-destination" if="{{ mapReady && navDestinationVisible }}" src="{{ navDestinationPath }}" style="{{ navDestinationStyle }}" />
        <image class="nav-marker" if="{{ mapReady && navMarkerVisible }}" src="{{ navMarkerPath }}" style="{{ navMarkerStyle }}" />
      </div>
      <div class="nav-header" if="{{ mapReady || pendingPublication || preparedRender }}">
        <image class="nav-arrow" src="{{ navArrowPath }}" />
        <text class="nav-distance">{{ navDistance }}</text>
        <text class="nav-street">{{ navStreet }}</text>
        <text class="nav-status" if="{{ navStatusVisible }}">{{ navStatus }}</text>
      </div>
      <text class="online" if="{{ !mapReady && !pendingPublication && !preparedRender }}">{{ startupStatus }}</text>
    </div>
  </div>
</template>

<script>
import interconnect from "@system.interconnect"
import file from "@system.file"
// BEGIN CORRIDOR MAP
var corridorMap = (function () {
// Bounded file/decode bookkeeping; the page owns native file and image callbacks.
const CELL = 128
const MAX_FILES = 30
const MAX_RESIDENT = 24

function integer(value, limit) {
  return Number.isInteger(value) && Math.abs(value) <= limit
}

function validKey(key) {
  if (typeof key !== "string" || !/^-?(0|[1-9][0-9]{0,2}):-?(0|[1-9][0-9]{0,2})$/.test(key)) return false
  const parts = key.split(":").map(Number)
  return parts.every(value => integer(value, 261)) && `${parts[0]}:${parts[1]}` === key
}

function cells(x, y) {
  if (!integer(x, 32768) || !integer(y, 32768)) return []
  const output = []
  for (let row = Math.floor(-y / CELL); row < Math.ceil((520 - y) / CELL); row++) {
    for (let column = Math.floor(-x / CELL); column < Math.ceil((212 - x) / CELL); column++) {
      output.push(`${column}:${row}`)
    }
  }
  return output
}

function create(epoch) {
  const files = Object.create(null)
  let order = [], active = [], activeRecords = [], retired = [], wanted = null, latest = null
  const state = {
    epoch,
    visible: false,
    closed: false,
    destination: null,
    position: { x: 0, y: 0, seq: -1 },
    get count() { return records().length },
    has(key) { return !!files[key] },
    hash(key) { return files[key] && files[key].hash },
    records() { return records().concat(retired) },
    takeRetired() { const result = retired; retired = []; return result },
    freeze() {
      const removed = unique(records().concat(retired)).filter(record => activeRecords.indexOf(record) < 0)
      for (const key of order) delete files[key]
      for (const record of activeRecords) files[record.key] = record
      order = active.slice(); wanted = null; retired = []; state.closed = true
      return removed
    },
    store(key, uri, bytes, hash) {
      if (state.closed || !validKey(key) || typeof uri !== "string" || !uri || !Number.isInteger(bytes) || bytes < 1 || bytes > 8192) {
        return { ok: false, evicted: [] }
      }
      const old = files[key]
      if (old && old.uri === uri) return { ok: old.bytes === bytes && old.hash === hash, evicted: [] }
      const next = { key, uri, bytes, hash, decoded: false }
      const target = wanted ? wanted.keys : active
      const future = target.map(candidate => candidate === key ? next : files[candidate]).filter(Boolean)
      if (unique(activeRecords.concat(future)).length > MAX_RESIDENT) return { ok: false, evicted: [] }
      const pinned = active.concat(wanted ? wanted.keys : [])
      const evicted = []
      if (records().length >= MAX_FILES && (!old || activeRecords.indexOf(old) >= 0)) {
        const victim = order.find(candidate => pinned.indexOf(candidate) < 0)
        if (!victim) return { ok: false, evicted: [] }
        evicted.push(files[victim])
        delete files[victim]
        order = order.filter(candidate => candidate !== victim)
      }
      if (old && activeRecords.indexOf(old) < 0) evicted.push(old)
      files[key] = next
      order = order.filter(candidate => candidate !== key)
      order.push(key)
      if (state.visible && active.indexOf(key) >= 0 && !wanted) {
        wanted = { seq: state.position.seq, x: state.position.x, y: state.position.y, keys: active.slice(), destination: state.destination }
      }
      return { ok: true, evicted }
    },
    request(seq, x, y, destination) {
      const keys = cells(x, y)
      if (state.closed || !integer(seq, 2147483647) || seq < 0 || !keys.length ||
          (latest && (seq < latest.seq || (seq === latest.seq && (x !== latest.x || y !== latest.y))))) {
        return { ok: false, reason: "invalidView", missing: [] }
      }
      if (state.visible && (Math.abs(x - state.position.x) > CELL || Math.abs(y - state.position.y) > CELL)) {
        return { ok: false, reason: "resetRequired", missing: [] }
      }
      const resident = unique(activeRecords.concat(keys.map(key => files[key] || { key, uri: "missing-" + key })))
      if (resident.length > MAX_RESIDENT) return { ok: false, reason: "resetRequired", missing: [] }
      latest = { seq, x, y }
      wanted = { seq, x, y, keys, destination: destination || state.destination }
      for (const key of keys) {
        if (files[key]) { order = order.filter(candidate => candidate !== key); order.push(key) }
      }
      const missing = keys.filter(key => !files[key])
      promote()
      return { ok: true, missing }
    },
    images() {
      // An unmounted native image must decode again if its file is later reused.
      // Decode arrivals independently: a visible replacement's sender waits for
      // its decode reply before it can transfer the still-missing entering cells.
      const pending = wanted ? wanted.keys.map(key => files[key]).filter(Boolean) : []
      const resident = unique(activeRecords.concat(pending))
      for (const key of order) if (resident.indexOf(files[key]) < 0) files[key].decoded = false
      return resident.map(file => {
        const parts = file.key.split(":").map(Number)
        const shown = activeRecords.indexOf(file) >= 0 && state.visible
        return { key: file.key, uri: file.uri, opacity: shown ? 1 : 0,
          x: parts[0] * CELL + state.position.x, y: parts[1] * CELL + state.position.y }
      })
    },
    decoded(key, uri) {
      const file = records().find(file => file.key === key && file.uri === uri)
      if (!file || state.images().every(item => item.uri !== uri)) return false
      file.decoded = true
      promote()
      return true
    },
    failed(key, uri) {
      const file = files[key]
      if (!file || file.uri !== uri) return false
      const fallback = activeRecords.find(record => record.key === key && record.uri !== uri)
      if (fallback) files[key] = fallback
      else {
        if (active.indexOf(key) >= 0) { state.visible = false; active = []; activeRecords = [] }
        delete files[key]
        order = order.filter(candidate => candidate !== key)
      }
      wanted = null
      return true
    }
  }
  function unique(items) { return items.filter((item, index) => items.findIndex(other => other.uri === item.uri) === index) }
  function records() { return unique(order.map(key => files[key]).concat(activeRecords)) }
  function promote() {
    if (!wanted || !wanted.keys.every(key => files[key] && files[key].decoded)) return
    for (const record of activeRecords) if (files[record.key] !== record) retired.push(record)
    active = wanted.keys
    activeRecords = active.map(key => files[key])
    state.position = { seq: wanted.seq, x: wanted.x, y: wanted.y }
    state.destination = wanted.destination
    state.visible = true
    wanted = null
    for (const key of order) if (active.indexOf(key) < 0) files[key].decoded = false
  }
  return state
}

function validPNG(bytes) {
  const signature = [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82]
  if (!bytes || bytes.length < 33 || signature.some((value, index) => bytes[index] !== value)) return false
  // Reject image-size bombs before a native decoder sees the file.
  if ([16, 20].some(index => bytes[index] !== 0 || bytes[index + 1] !== 0 || bytes[index + 2] !== 0 || bytes[index + 3] !== CELL)) return false
  return (bytes[24] === 8 || (bytes[24] === 4 && bytes[25] === 3)) &&
    [0, 2, 3, 4, 6].indexOf(bytes[25]) >= 0 && bytes[26] === 0 && bytes[27] === 0 && bytes[28] === 0
}

return { cellSize: CELL, maximumFiles: MAX_FILES, maximumResident: MAX_RESIDENT, cells, validKey, validPNG, create }
})()
// END CORRIDOR MAP

var base64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function decodeBase64Bytes(value) {
  if (typeof value !== "string" || value.length === 0 || value.length % 4 !== 0 ||
    !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) return null
  var padding = value.slice(-2) === "==" ? 2 : value.slice(-1) === "=" ? 1 : 0
  var output = new Uint8Array(value.length * 3 / 4 - padding)
  var accumulator = 0
  var bits = 0
  var outputIndex = 0
  for (var index = 0; index < value.length && value.charAt(index) !== "="; index = index + 1) {
    var sixBits = base64Alphabet.indexOf(value.charAt(index))
    if (sixBits < 0) return null
    accumulator = (accumulator << 6) | sixBits
    bits = bits + 6
    if (bits >= 8) {
      bits = bits - 8
      output[outputIndex] = (accumulator >>> bits) & 255
      outputIndex = outputIndex + 1
      accumulator = bits === 0 ? 0 : accumulator & ((1 << bits) - 1)
    }
  }
  return outputIndex === output.length ? output : null
}

function safeMaskPixel(x, y, inset) {
  if (inset === undefined) inset = 12
  if (x < inset || x > 212 - inset || y < inset || y > 520 - inset) return false
  if (y < 106) return Math.sqrt((x - 106) * (x - 106) + (y - 106) * (y - 106)) <= 94
  if (y > 413) return Math.sqrt((x - 106) * (x - 106) + (y - 413) * (y - 413)) <= 94
  return true
}

function safeMaskContains(centerX, centerY, resourceWidth, resourceHeight, margin, inset) {
  if (margin === undefined) margin = 6
  if (inset === undefined) inset = 12
  var halfWidth = resourceWidth / 2 + margin
  var halfHeight = resourceHeight / 2 + margin
  return safeMaskPixel(centerX - halfWidth, centerY - halfHeight, inset) &&
    safeMaskPixel(centerX + halfWidth, centerY - halfHeight, inset) &&
    safeMaskPixel(centerX - halfWidth, centerY + halfHeight, inset) &&
    safeMaskPixel(centerX + halfWidth, centerY + halfHeight, inset)
}

function safeMaskClamp(desiredX, desiredY, resourceWidth, resourceHeight, margin) {
  if (margin === undefined) margin = 6
  if (safeMaskContains(desiredX, desiredY, resourceWidth, resourceHeight, margin)) return { x: desiredX, y: desiredY }
  var low = 0
  var high = 1
  for (var index = 0; index < 32; index = index + 1) {
    var ratio = (low + high) / 2
    var x = Math.round(106 + (desiredX - 106) * ratio)
    var y = Math.round(260 + (desiredY - 260) * ratio)
    if (safeMaskContains(x, y, resourceWidth, resourceHeight, margin)) low = ratio
    else high = ratio
  }
  var resultX = Math.round(106 + (desiredX - 106) * low)
  var resultY = Math.round(260 + (desiredY - 260) * low)
  while (!safeMaskContains(resultX, resultY, resourceWidth, resourceHeight, margin) && (resultX !== 106 || resultY !== 260)) {
    if (resultX !== 106) resultX = resultX + (resultX < 106 ? 1 : -1)
    if (resultY !== 260) resultY = resultY + (resultY < 260 ? 1 : -1)
  }
  return { x: resultX, y: resultY }
}

var sha256Constants = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

function sha256Rotate(value, count) {
  return (value >>> count) | (value << (32 - count))
}

function sha256Block(context, block) {
  var words = context.words
  var index
  for (index = 0; index < 16; index = index + 1) {
    var offset = index * 4
    words[index] = (block[offset] << 24) | (block[offset + 1] << 16) |
      (block[offset + 2] << 8) | block[offset + 3]
  }
  for (index = 16; index < 64; index = index + 1) {
    var previous = words[index - 15]
    var prior = words[index - 2]
    var sigma0 = sha256Rotate(previous, 7) ^ sha256Rotate(previous, 18) ^ (previous >>> 3)
    var sigma1 = sha256Rotate(prior, 17) ^ sha256Rotate(prior, 19) ^ (prior >>> 10)
    words[index] = (words[index - 16] + sigma0 + words[index - 7] + sigma1) | 0
  }
  var a = context.state[0]
  var b = context.state[1]
  var c = context.state[2]
  var d = context.state[3]
  var e = context.state[4]
  var f = context.state[5]
  var g = context.state[6]
  var h = context.state[7]
  for (index = 0; index < 64; index = index + 1) {
    var sum1 = sha256Rotate(e, 6) ^ sha256Rotate(e, 11) ^ sha256Rotate(e, 25)
    var choice = (e & f) ^ (~e & g)
    var temporary1 = (h + sum1 + choice + sha256Constants[index] + words[index]) | 0
    var sum0 = sha256Rotate(a, 2) ^ sha256Rotate(a, 13) ^ sha256Rotate(a, 22)
    var majority = (a & b) ^ (a & c) ^ (b & c)
    var temporary2 = (sum0 + majority) | 0
    h = g
    g = f
    f = e
    e = (d + temporary1) | 0
    d = c
    c = b
    b = a
    a = (temporary1 + temporary2) | 0
  }
  context.state[0] = (context.state[0] + a) | 0
  context.state[1] = (context.state[1] + b) | 0
  context.state[2] = (context.state[2] + c) | 0
  context.state[3] = (context.state[3] + d) | 0
  context.state[4] = (context.state[4] + e) | 0
  context.state[5] = (context.state[5] + f) | 0
  context.state[6] = (context.state[6] + g) | 0
  context.state[7] = (context.state[7] + h) | 0
}

function sha256Create() {
  return {
    state: new Int32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
      0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]),
    block: new Uint8Array(64),
    words: new Int32Array(64),
    blockLength: 0,
    byteLength: 0
  }
}

function sha256Update(context, bytes) {
  context.byteLength = context.byteLength + bytes.length
  for (var index = 0; index < bytes.length; index = index + 1) {
    context.block[context.blockLength] = bytes[index]
    context.blockLength = context.blockLength + 1
    if (context.blockLength === 64) {
      sha256Block(context, context.block)
      context.blockLength = 0
    }
  }
}

function sha256Finish(context) {
  var bitLengthLow = (context.byteLength * 8) >>> 0
  var bitLengthHigh = Math.floor(context.byteLength / 0x20000000) >>> 0
  context.block[context.blockLength] = 0x80
  context.blockLength = context.blockLength + 1
  if (context.blockLength > 56) {
    while (context.blockLength < 64) context.block[context.blockLength++] = 0
    sha256Block(context, context.block)
    context.blockLength = 0
  }
  while (context.blockLength < 56) context.block[context.blockLength++] = 0
  for (var index = 0; index < 4; index = index + 1) {
    context.block[56 + index] = (bitLengthHigh >>> (24 - index * 8)) & 255
    context.block[60 + index] = (bitLengthLow >>> (24 - index * 8)) & 255
  }
  sha256Block(context, context.block)
  var digest = ""
  for (index = 0; index < 8; index = index + 1) {
    var word = (context.state[index] >>> 0).toString(16)
    digest = digest + "00000000".slice(word.length) + word
  }
  return digest
}

// Keep the Band entry self-contained. The Vela page loader is the most fragile
// part of this POC; importing pure helpers here creates a webpack module graph
// that is evaluated before the first frame is drawn. These ES5 helpers mirror
// the tested host-side modules without adding runtime imports to the RPK page.
var renderProtocolLimits = {
  envelopeBytes: 1024,
  payloadBytes: 8192,
  width: 212,
  height: 520,
  maximumPrimitives: 0,
  formatVersion: 1,
  maximumIdentifierBytes: 24
}

function renderProtocolUTF8Length(value) {
  if (typeof value !== "string") return 0
  var length = 0
  for (var index = 0; index < value.length; index += 1) {
    var code = value.charCodeAt(index)
    if (code < 128) length += 1
    else if (code < 2048) length += 2
    else if (code >= 55296 && code <= 56319 && index + 1 < value.length) {
      index += 1
      length += 4
    } else length += 3
  }
  return length
}

function renderProtocolValidIdentifier(value) {
  return typeof value === "string" && renderProtocolUTF8Length(value) >= 1 &&
    renderProtocolUTF8Length(value) <= renderProtocolLimits.maximumIdentifierBytes && /^[\x20-\x7e]+$/.test(value)
}

function renderProtocolValidSHA256(value) {
  return typeof value === "string" && /^[0-9a-f]{64}$/.test(value)
}

function renderProtocolValidInteger(value) {
  return typeof value === "number" && isFinite(value) && Math.floor(value) === value
}

function renderProtocolReject(code) {
  return { ok: false, code: code }
}

function validRoundaboutExit(body) {
  return (body.roundaboutExit === undefined || (body.maneuver === "roundabout" &&
    renderProtocolValidInteger(body.roundaboutExit) && body.roundaboutExit >= 1 && body.roundaboutExit <= 12)) &&
    (body.roundaboutDirection === undefined || (body.maneuver === "roundabout" &&
      ["straight", "left", "right", "uTurn"].indexOf(body.roundaboutDirection) >= 0))
}

function maneuverPath(body) {
  if (body.maneuver === "roundabout" && body.roundaboutDirection !== undefined) {
    return body.roundaboutDirection === "uTurn" ? "/common/maneuver-uTurn.png" :
      "/common/maneuver-roundabout-" + body.roundaboutDirection + ".png"
  }
  return "/common/maneuver-" + body.maneuver +
    (body.maneuver === "roundabout" && body.roundaboutExit !== undefined ? "-" + body.roundaboutExit : "") + ".png"
}

function renderProtocolValidPreview(preview) {
  var maneuvers = ["straight", "left", "right", "uTurn", "roundabout", "arrive"]
  return preview && typeof preview === "object" && !Array.isArray(preview) &&
    maneuvers.indexOf(preview.maneuver) >= 0 &&
    validRoundaboutExit(preview) &&
    renderProtocolValidInteger(preview.distanceM) && preview.distanceM >= 0 &&
    typeof preview.street === "string" && renderProtocolUTF8Length(preview.street) <= 48 &&
    renderProtocolValidInteger(preview.x) && renderProtocolValidInteger(preview.y) &&
    safeMaskContains(preview.x, preview.y, 30, 38) &&
    renderProtocolValidInteger(preview.heading) && preview.heading >= 0 && preview.heading < 8 &&
    validDestination(preview)
}

function validDestination(preview) {
  return preview && ["visible", "edge", "hidden"].indexOf(preview.destinationMode) >= 0 &&
    renderProtocolValidInteger(preview.destinationX) && renderProtocolValidInteger(preview.destinationY) &&
    (preview.destinationMode === "hidden" ? preview.destinationX === 0 && preview.destinationY === 0 :
      safeMaskContains(preview.destinationX, preview.destinationY,
        preview.destinationMode === "visible" ? 28 : 24,
        preview.destinationMode === "visible" ? 34 : 24,
        preview.destinationMode === "edge" ? 0 : 6,
        preview.destinationMode === "edge" ? 0 : 12))
}

function renderProtocolValidatePrepare(body, options) {
  options = options || {}
  if (options.prepared) return renderProtocolReject("busy")
  if (!body || typeof body !== "object" || Array.isArray(body)) return renderProtocolReject("unsupportedRenderer")
  if (body.renderer !== "raster") return renderProtocolReject("unsupportedRenderer")
  if (body.formatVersion !== renderProtocolLimits.formatVersion) return renderProtocolReject("unsupportedFormatVersion")
  if (body.format !== "image/png" && body.format !== "image/jpeg") {
    return renderProtocolReject("unsupportedFormatVersion")
  }
  if (body.width !== renderProtocolLimits.width || body.height !== renderProtocolLimits.height) {
    return renderProtocolReject("invalidDimensions")
  }
  if (!renderProtocolValidInteger(body.bytes) || body.bytes <= 0 || body.bytes > renderProtocolLimits.payloadBytes) {
    return renderProtocolReject("payloadTooLarge")
  }
  if (!renderProtocolValidInteger(body.primitives) || body.primitives < 0 || body.primitives > renderProtocolLimits.maximumPrimitives) {
    return renderProtocolReject("tooManyPrimitives")
  }
  if (!renderProtocolValidIdentifier(body.runId) || !renderProtocolValidIdentifier(body.sceneId) || !renderProtocolValidSHA256(body.sha256)) {
    return renderProtocolReject("unsupportedFormatVersion")
  }
  if (options.availableStorageBytes !== undefined && body.bytes > options.availableStorageBytes) {
    return renderProtocolReject("insufficientStorage")
  }
  if (body.preview !== undefined && !renderProtocolValidPreview(body.preview)) {
    return renderProtocolReject("unsupportedFormatVersion")
  }
  return {
    ok: true,
    prepared: {
      runId: body.runId,
      sceneId: body.sceneId,
      renderer: body.renderer,
      format: body.format,
      formatVersion: body.formatVersion,
      width: body.width,
      height: body.height,
      bytes: body.bytes,
      sha256: body.sha256,
      primitives: body.primitives,
      preview: body.preview
    }
  }
}

function renderProtocolValidateAssetBegin(body, prepared) {
  if (!prepared) return renderProtocolReject("notPrepared")
  if (!body || typeof body !== "object" ||
    body.run !== prepared.runId || body.scene !== prepared.sceneId ||
    body.renderer !== prepared.renderer || body.formatVersion !== prepared.formatVersion ||
    body.width !== prepared.width || body.height !== prepared.height ||
    body.bytes !== prepared.bytes || body.sha256 !== prepared.sha256 ||
    body.primitives !== prepared.primitives || body.format !== prepared.format) {
    return renderProtocolReject("notPrepared")
  }
  return { ok: true }
}

var renderProtocol = {
  validIdentifier: renderProtocolValidIdentifier,
  validSHA256: renderProtocolValidSHA256,
  validatePrepare: renderProtocolValidatePrepare,
  validateAssetBegin: renderProtocolValidateAssetBegin
}

export default {
  private: {
    MAX_ENVELOPE_BYTES: 1024,
    MAX_RECENT_IDS: 64,
    MAX_ASSET_BYTES: 8192,
    MAP_WIDTH: 212,
    MAP_HEIGHT: 520,
    connection: null,
    connectionProbeTimer: null,
    connectionProbeInFlight: false,
    destroyed: false,
    acceptingMessages: false,
    waiting: true,
    connected: false,
    logText: "Echo ready.",
    logRows: [],
    recentIDs: [],
    inFlightIDs: [],
    lastReceivePhase: "none",
    lastReceiveOffset: -1,
    lastReceivedBytes: 0,
    lastSendCode: 0,
    lifecycleEpoch: 0,
    activeMapOperationID: "",
    pendingDeleteURIs: [],
    activeTransfer: null,
    unconfirmedURI: "",
    unconfirmedTouched: false,
    mapReady: false,
    streamVisible: false,
    streamImages: [],
    mapPath: "",
    mapHashPrefix: "",
    mapRenderer: "",
    mapToken: "",
    navScene: "",
    navSequence: -1,
    navArrowPath: "/common/maneuver-straight.png",
    navDistance: "—",
    navStreet: "",
    navStatus: "WAITING",
    navStatusVisible: false,
    startupStatus: "CHỜ LỆNH TỪ IPHONE…",
    navMarkerPath: "/common/marker-cursor-v4.png",
    navMarkerStyle: "left:91px;top:355px;",
    navMarkerVisible: false,
    navDestinationVisible: false,
    navDestinationPath: "/common/destination-pin.png",
    navDestinationStyle: "left:96px;top:108px;",
    pendingPublication: null,
    pendingMapPath: "",
    pendingMapToken: "",
    preparedRender: null,
    confirmedMap: null,
    retiredMapURI: "",
    nextRenderToken: 1,
    showDiagnostics: true,
    nextID: 1
  },

  onReady() {
    this.streamState = null
    this.streamTransfer = null
    this.streamWritePending = false
    this.streamGarbage = []
    this.streamCleanupPending = false
    this.streamCleanupDone = false
    this.destroyed = false
    this.cleanAbandonedCells()
    this.acceptingMessages = false
    this.connected = false
    try {
      this.connection = interconnect.instance()
      this.bindConnectionHandlers(this.connection)
      this.probeConnection()
    } catch (error) {
      this.connection = null
    }
  },

  bindConnectionHandlers(connection) {
    if (!this.ownsConnection(connection)) return
    var page = this
    var epoch = this.lifecycleEpoch
    connection.onopen = function () {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.probeConnection()
    }
    connection.onclose = function () {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.lock("IOS LINK CLOSED")
    }
    connection.onerror = function () {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.lock("IOS LINK ERROR")
    }
    connection.onmessage = function (event) {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.receiveMessage(event)
    }
  },

  onDestroy() {
    if (this.destroyed) return
    this.destroyed = true
    this.acceptingMessages = false
    this.connected = false
    this.waiting = true
    this.stopConnectionPolling()
    this.connectionProbeInFlight = false
    this.resetMapLifecycle()
    if (!this.connection) return
    this.connection.onopen = null
    this.connection.onclose = null
    this.connection.onerror = null
    this.connection.onmessage = null
  },

  probeConnection() {
    if (this.destroyed || this.connected || this.connectionProbeInFlight || !this.connection) return
    var page = this
    var ownedConnection = this.connection
    var epoch = this.lifecycleEpoch
    this.connectionProbeInFlight = true
    var finish = function (ready) {
      if (!page.ownsConnectionEpoch(ownedConnection, epoch)) return
      page.connectionProbeInFlight = false
      if (ready) page.unlock(ownedConnection)
      else page.scheduleConnectionProbe()
    }
    try {
      ownedConnection.getReadyState({
        success: function (result) { finish(result.status === 1) },
        fail: function () { finish(false) }
      })
    } catch (error) {
      finish(false)
    }
  },

  scheduleConnectionProbe() {
    if (this.destroyed || this.connected || this.connectionProbeTimer !== null) return
    var page = this
    this.connectionProbeTimer = setTimeout(function () {
      page.connectionProbeTimer = null
      page.probeConnection()
    }, 2000)
  },

  stopConnectionPolling() {
    if (this.connectionProbeTimer === null) return
    clearTimeout(this.connectionProbeTimer)
    this.connectionProbeTimer = null
  },

  unlock(connection) {
    var ownedConnection = connection || this.connection
    if (!this.ownsConnection(ownedConnection)) return
    var newSession = !this.connected
    this.waiting = false
    this.connected = true
    this.acceptingMessages = true
    this.stopConnectionPolling()
    this.bindConnectionHandlers(ownedConnection)
    this.logRows = []
    if (newSession) this.recentIDs = []
    this.logText = "Echo ready."
  },

  lock(reason) {
    if (this.destroyed) return
    this.acceptingMessages = false
    this.connected = false
    this.connectionProbeInFlight = false
    this.resetMapLifecycle()
    this.waiting = true
    this.scheduleConnectionProbe()
  },

  ownsConnection(connection) {
    return !this.destroyed && !!connection && this.connection === connection
  },

  ownsConnectionEpoch(connection, epoch) {
    return this.ownsConnection(connection) && this.lifecycleEpoch === epoch
  },

  resetMapLifecycle() {
    this.resetStream()
    this.restorePreparedNavigation()
    this.lifecycleEpoch = this.lifecycleEpoch + 1
    this.navScene = ""
    this.navSequence = -1
    this.navStatus = "WAITING"
    this.navStatusVisible = false
    this.navMarkerVisible = false
    this.navDestinationVisible = false
    this.startupStatus = "CHỜ LỆNH TỪ IPHONE…"
    var cleanupURI = this.pendingPublication ? this.pendingPublication.uri :
      (this.activeTransfer ? this.activeTransfer.uri : this.unconfirmedURI)
    var preserveURI = this.confirmedMap ? this.confirmedMap.uri : ""
    var shouldDelete = cleanupURI && (cleanupURI !== preserveURI || this.unconfirmedTouched)
    this.activeMapOperationID = ""
    this.inFlightIDs = []
    this.activeTransfer = null
    this.pendingPublication = null
    this.pendingMapPath = ""
    this.pendingMapToken = ""
    this.unconfirmedURI = ""
    this.unconfirmedTouched = false
    if (this.confirmedMap) {
      this.mapPath = this.confirmedMap.uri
      this.mapHashPrefix = this.confirmedMap.sha256Prefix
      this.mapReady = true
      this.mapRenderer = this.confirmedMap.renderer || "raster"
      this.mapToken = this.confirmedMap.token
    } else {
      this.mapPath = ""
      this.mapHashPrefix = ""
      this.mapRenderer = ""
      this.mapReady = false
      this.mapToken = ""
      this.showDiagnostics = true
    }
    if (shouldDelete) this.deleteBestEffort(cleanupURI)
  },

  restorePreparedNavigation() {
    var previous = this.preparedRender && this.preparedRender.previousNavigation
    if (previous) {
      this.navArrowPath = previous.arrowPath
      this.navDistance = previous.distance
      this.navStreet = previous.street
      this.navStatus = previous.status
      this.navStatusVisible = previous.statusVisible
    } else {
      this.navArrowPath = "/common/maneuver-straight.png"
      this.navDistance = "—"
      this.navStreet = ""
      this.navStatus = "WAITING"
      this.navStatusVisible = false
    }
    this.preparedRender = null
  },

  utf8Length(text) {
    var length = 0
    for (var index = 0; index < text.length; index = index + 1) {
      var code = text.charCodeAt(index)
      if (code < 128) length = length + 1
      else if (code < 2048) length = length + 2
      else if (code >= 55296 && code <= 56319 && index + 1 < text.length) {
        index = index + 1
        length = length + 4
      } else length = length + 3
    }
    return length
  },

  validID(id) {
    if (typeof id !== "string" || id.length < 1 || id.length > 32) return false
    for (var index = 0; index < id.length; index = index + 1) {
      var code = id.charCodeAt(index)
      if (code < 32 || code > 126) return false
    }
    return true
  },

  validTopic(topic) {
    return typeof topic === "string" && topic.length >= 1 && topic.length <= 64 &&
      /^[a-z0-9-]+(\.[a-z0-9-]+)*$/.test(topic)
  },

  validBody(body) {
    return body !== null && typeof body === "object" && !Array.isArray(body)
  },

  validEnvelope(message, source) {
    if (!message || message.v !== 1 || message.src !== source || !this.validID(message.id)) return false
    var encoded
    try { encoded = JSON.stringify(message) } catch (error) { return false }
    if (this.utf8Length(encoded) > this.MAX_ENVELOPE_BYTES) return false
    if (message.type === "ack") return message.topic === undefined && message.body === undefined
    if (message.type !== "message") return false
    return this.validTopic(message.topic) && this.validBody(message.body)
  },

  receiveMessage(event) {
    if (this.destroyed || !this.connected || !this.acceptingMessages) return
    var message = event
    if (event && event.data !== undefined) message = event.data
    if (typeof message === "string") {
      try { message = JSON.parse(message) } catch (error) { return }
    }
    if (!this.validEnvelope(message, "ios")) return
    if (message.type === "ack") {
      this.acknowledge(message.id)
      return
    }

    if (message.topic === "diagnostics.get") {
      var request = message.body.request
      if (typeof request !== "string" || !/^[a-z0-9-]{1,32}$/.test(request)) return
      this.sendEnvelope({
        v: 1, id: this.nextBandMessageID(), src: "band", type: "message", topic: "diagnostics.report",
        body: {
          request: request, rpk: 32, phase: this.lastReceivePhase,
          offset: this.lastReceiveOffset, received: this.lastReceivedBytes, sendCode: this.lastSendCode
        }
      })
      this.sendACK(message.id)
      return
    }
    var phases = { "render.prepare": "prepare", "map.asset.begin": "begin", "map.asset.chunk": "chunk", "map.asset.end": "end" }
    if (typeof phases[message.topic] === "string") {
      this.lastReceivePhase = phases[message.topic]
      if (message.topic === "render.prepare" && this.recentIDs.indexOf(message.id) < 0 &&
        this.inFlightIDs.indexOf(message.id) < 0 && !this.preparedRender) {
        this.lastReceiveOffset = -1
        this.lastReceivedBytes = 0
        this.lastSendCode = 0
      }
      if (message.topic === "map.asset.chunk" && this.validInteger(message.body.offset) &&
        message.body.offset >= 0 && message.body.offset <= this.MAX_ASSET_BYTES) {
        this.lastReceiveOffset = message.body.offset
      }
    }

    if (message.topic === "render.reset") {
      var reset = message.body
      if (!renderProtocol.validIdentifier(reset.runId) || !renderProtocol.validIdentifier(reset.sceneId)) return
      var owned = this.preparedRender
      if (owned && (owned.runId !== reset.runId || owned.sceneId !== reset.sceneId)) return
      // Let native file I/O complete before resetting; its callback must not
      // recreate a file after cleanup. The bounded reset retry can then proceed.
      if (this.activeMapOperationID && !this.pendingPublication) return
      if (!owned && (this.activeTransfer || this.pendingPublication || this.activeMapOperationID)) return
      // A timed-out phone may resume only after the interrupted generation is
      // invalidated. Late writes/decode callbacks retain their old epoch.
      if (owned) {
        this.resetMapLifecycle()
        this.bindConnectionHandlers(this.connection)
      }
      this.sendEnvelope({
        v: 1, id: this.nextBandMessageID(), src: "band", type: "message", topic: "render.reset.ready",
        body: { request: message.id, runId: reset.runId, sceneId: reset.sceneId }
      })
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    if (this.recentIDs.indexOf(message.id) >= 0) {
      this.sendACK(message.id)
      return
    }
    if (this.inFlightIDs.indexOf(message.id) >= 0) return
    if (message.topic.indexOf("map.cell.") === 0) {
      this.handleCellMessage(message)
      return
    }
    if (message.topic.indexOf("map.stream.") === 0) {
      this.handleStreamMessage(message)
      return
    }
    if (message.topic === "nav.update") {
      this.handleNavigationUpdate(message)
      return
    }
    if (message.topic === "nav.status") {
      var startupLabels = { locating: "LOCATING", gpsLow: "GPS LOW" }
      if (message.body && startupLabels[message.body.status]) this.startupStatus = startupLabels[message.body.status]
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    if (message.topic === "render.prepare") {
      this.handleRenderPrepare(message)
      return
    }
    if (message.topic === "render.cancel") {
      var cancelled = message.body && this.preparedRender &&
        message.body.runId === this.preparedRender.runId && message.body.sceneId === this.preparedRender.sceneId
      if (cancelled) this.restorePreparedNavigation()
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    if (message.topic.indexOf("map.asset.") === 0) {
      if (this.activeMapOperationID) {
        this.failAsset(message, "ASSET_BUSY")
        return
      }
      if (message.topic === "map.asset.begin") {
        var admission = renderProtocol.validateAssetBegin(message.body, this.preparedRender)
        if (!admission.ok) {
          this.rejectUnpreparedAsset(message)
          return
        }
      }
      this.activeMapOperationID = message.id
      this.inFlightIDs.push(message.id)
      try { this.receiveAssetMessage(message) } catch (error) {
        this.failAsset(message, "ASSET_OPERATION_FAILED")
      }
      return
    }
    if (message.topic === "system.echo") {
      var text = typeof message.body.text === "string" ? message.body.text : "(object)"
      this.appendRow(message.id, "IOS > " + text, false)
    }
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  isRouteCardBeginBody(body) {
    return !!body && (body.renderer !== undefined || body.format !== undefined ||
      body.scene !== undefined || body.formatVersion !== undefined)
  },

  handleNavigationUpdate(message) {
    var body = message.body
    var maneuvers = ["straight", "left", "right", "uTurn", "roundabout", "arrive"]
    var statuses = ["navigating", "gpsLow", "limitedMap", "rerouting", "arrived"]
    var currentScene = this.confirmedMap && this.confirmedMap.scene
    var valid = body && body.scene === currentScene && this.validInteger(body.seq) && body.seq > this.navSequence &&
      this.validInteger(body.x) && body.x >= 0 && body.x < this.MAP_WIDTH &&
      this.validInteger(body.y) && body.y >= 0 && body.y < this.MAP_HEIGHT &&
      this.validInteger(body.heading) && body.heading >= 0 && body.heading < 8 &&
      this.validInteger(body.distanceM) && body.distanceM >= 0 &&
      typeof body.street === "string" && this.utf8Length(body.street) <= 48 &&
      maneuvers.indexOf(body.maneuver) >= 0 && statuses.indexOf(body.status) >= 0 &&
      validRoundaboutExit(body) && validDestination(body)
    if (valid) {
      var labels = { navigating: "NAVIGATING", gpsLow: "GPS LOW", limitedMap: "LIMITED MAP", rerouting: "REROUTING", arrived: "ARRIVED" }
      this.navScene = body.scene
      this.navSequence = body.seq
      this.navMarkerVisible = true
      this.navMarkerPath = "/common/marker-cursor-v4.png"
      var navigation = {
        arrowPath: maneuverPath(body),
        distance: body.status === "arrived" ? "ARRIVED" : this.formatDistance(body.distanceM),
        street: body.street,
        status: labels[body.status],
        statusVisible: body.status !== "navigating"
      }
      if (this.preparedRender && this.preparedRender.preview && this.preparedRender.sceneId !== body.scene) {
        this.preparedRender.previousNavigation = navigation
      }
      this.navArrowPath = navigation.arrowPath
      this.navDistance = navigation.distance
      this.navStreet = navigation.street
      this.navStatus = navigation.status
      this.navStatusVisible = navigation.statusVisible
      this.navMarkerStyle = "left:91px;top:355px;"
      if (!this.streamVisible || body.status === "arrived") this.applyDestination(body)
    }
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  resetStream() {
    var previous = this.streamState
    var transfer = this.streamTransfer
    this.streamState = null
    this.streamTransfer = null
    this.streamImages = []
    this.streamVisible = false
    if (previous && this.confirmedMap) this.applyPreviewOverlay(this.confirmedMap.preview)
    if (previous) {
      var page = this
      previous.records().forEach(function (record) { page.retireCellFile(record.uri) })
    }
    if (transfer && transfer.uri) this.retireCellFile(transfer.uri)
  },

  retireCellFile(uri) {
    if (typeof uri !== "string" || !/^internal:\/\/files\/cell-[a-z0-9-]{1,80}\.png$/.test(uri)) return
    if (this.streamGarbage.indexOf(uri) < 0) this.streamGarbage.push(uri)
    var page = this
    this.scheduleDelete(uri, function () {
      page.streamGarbage = page.streamGarbage.filter(function (entry) { return entry !== uri })
    }, null)
  },

  cleanAbandonedCells() {
    if (this.streamCleanupDone || this.streamCleanupPending || this.destroyed) return
    this.streamCleanupPending = true
    var page = this, settled = false
    var finish = function (result) {
      if (settled) return
      settled = true
      page.streamCleanupPending = false
      if (page.destroyed || !result || !Array.isArray(result.fileList) || result.fileList.length > 256) return
      result.fileList.forEach(function (entry) {
        if (!entry || typeof entry.uri !== "string") return
        var uri = entry.uri.indexOf("internal://") === 0 ? entry.uri : "internal://files/" + entry.uri
        page.retireCellFile(uri)
      })
      page.streamCleanupDone = true
    }
    try { file.list({ uri: "internal://files/", success: finish, fail: function () { finish(null) } }) }
    catch (error) { finish(null) }
  },

  cellResult(epoch, cell, status, code, evicted, request) {
    this.sendStreamEnvelope("map.cell.result", {
      epoch: this.validRun(epoch) ? epoch : "", cell: corridorMap.validKey(cell) ? cell : "",
      status: status, code: code, evicted: evicted || [], request: request
    })
  },

  handleCellMessage(message) {
    var body = message.body || {}, state = this.streamState, transfer = this.streamTransfer
    var page = this
    var finish = function () { page.rememberSuccess(message.id); page.sendACK(message.id) }
    var reject = function (code, abandon) {
      if (abandon && page.streamTransfer === transfer) page.streamTransfer = null
      page.cellResult(body.epoch, body.cell, "error", code, [], message.id)
      finish()
    }
    if (!state || state.closed || body.epoch !== state.epoch || !corridorMap.validKey(body.cell)) {
      reject("invalidCell", false)
      return
    }
    if (message.topic === "map.cell.begin") {
      this.streamGarbage.slice().forEach(function (uri) { page.retireCellFile(uri) })
      if (transfer || this.streamWritePending || this.streamGarbage.length || this.preparedRender || this.activeTransfer || this.pendingPublication) {
        reject("busy", false)
        return
      }
      if (!this.validInteger(body.bytes) || body.bytes < 33 || body.bytes > 8192 || !renderProtocol.validSHA256(body.sha256)) {
        reject("invalidPayload", false)
        return
      }
      if (state.hash(body.cell) === body.sha256) {
        this.cellResult(body.epoch, body.cell, "stored", "cached", [], message.id)
        finish()
        return
      }
      this.streamTransfer = { epoch: body.epoch, cell: body.cell, bytes: body.bytes, sha256: body.sha256,
        buffer: new Uint8Array(body.bytes), offsets: [], received: 0, uri: "" }
      this.cellResult(body.epoch, body.cell, "accepted", "ok", [], message.id)
      finish()
      return
    }
    if (!transfer || transfer.epoch !== body.epoch || transfer.cell !== body.cell || this.streamWritePending) {
      reject("noTransfer", false)
      return
    }
    if (message.topic === "map.cell.chunk") {
      var bytes = this.decodeBase64(body.data), offset = body.offset
      if (!bytes || !this.validInteger(offset) || offset < 0 || offset % 216 !== 0 ||
        offset >= transfer.bytes || offset > transfer.received + 648 ||
        bytes.length !== Math.min(216, transfer.bytes - offset) || transfer.offsets.indexOf(offset) >= 0) {
        reject("invalidChunk", true)
        return
      }
      transfer.buffer.set(bytes, offset)
      transfer.offsets.push(offset)
      while (transfer.offsets.indexOf(transfer.received) >= 0) transfer.received += Math.min(216, transfer.bytes - transfer.received)
      finish()
      return
    }
    if (message.topic !== "map.cell.end" || transfer.received !== transfer.bytes) {
      reject("incomplete", true)
      return
    }
    var digest = sha256Create()
    sha256Update(digest, transfer.buffer)
    if (sha256Finish(digest) !== transfer.sha256 || !corridorMap.validPNG(transfer.buffer)) {
      reject("invalidPNG", true)
      return
    }
    transfer.uri = "internal://files/cell-" + transfer.epoch + "-" + this.lifecycleEpoch + "-" + this.nextRenderToken + ".png"
    this.nextRenderToken += 1
    this.streamWritePending = true
    var settled = false
    var complete = function (success) {
      if (settled) return
      settled = true
      page.streamWritePending = false
      transfer.buffer = null
      if (page.streamState !== state || page.streamTransfer !== transfer) {
        page.retireCellFile(transfer.uri)
        return
      }
      page.streamTransfer = null
      if (!success) {
        page.retireCellFile(transfer.uri)
        page.cellResult(transfer.epoch, transfer.cell, "error", "writeFailed", [], message.id)
        return
      }
      var stored = state.store(transfer.cell, transfer.uri, transfer.bytes, transfer.sha256)
      if (!stored.ok) page.retireCellFile(transfer.uri)
      stored.evicted.forEach(function (record) { page.retireCellFile(record.uri) })
      page.cellResult(transfer.epoch, transfer.cell, stored.ok ? "stored" : "error", stored.ok ? "ok" : "cacheFull",
        stored.evicted.filter(function (record) { return record.key !== transfer.cell }).map(function (record) { return record.key }), message.id)
      page.syncStreamImages()
    }
    // End ACK releases the sender; the separate result proves the native write completed.
    finish()
    try {
      file.writeArrayBuffer({ uri: transfer.uri, buffer: transfer.buffer, position: 0,
        success: function () { complete(true) }, fail: function () { complete(false) } })
    } catch (error) { complete(false) }
  },

  sendStreamEnvelope(topic, body) {
    this.sendEnvelope({ v: 1, id: this.nextBandMessageID(), src: "band", type: "message", topic: topic, body: body })
  },

  handleStreamMessage(message) {
    var body = message.body || {}
    if (message.topic === "map.stream.open") this.cleanAbandonedCells()
    if (message.topic === "map.stream.open" && this.streamGarbage.length) {
      var page = this
      this.streamGarbage.slice().forEach(function (uri) { page.retireCellFile(uri) })
    }
    if (message.topic === "map.stream.open" && body.version === 1 &&
      this.confirmedMap && body.scene === this.confirmedMap.scene &&
      this.validRun(body.epoch) && !this.activeTransfer && !this.pendingPublication && !this.preparedRender &&
      !this.streamWritePending && !this.streamGarbage.length) {
      if (!this.streamCleanupDone || this.streamCleanupPending) {
        this.rememberSuccess(message.id)
        this.sendACK(message.id)
        return
      }
      if (!this.streamState || this.streamState.epoch !== body.epoch) {
        this.resetStream()
        this.streamState = corridorMap.create(body.epoch)
      }
      this.sendStreamEnvelope("map.stream.ready", {
        scene: body.scene, epoch: body.epoch, version: 1, cellSize: corridorMap.cellSize,
        maximumFiles: corridorMap.maximumFiles, maximumResident: corridorMap.maximumResident
      })
    } else if (this.streamState && body.epoch === this.streamState.epoch) {
      if (message.topic === "map.stream.view") {
        var destination = body.destinationMode === undefined ? null : body
        var result = destination && !validDestination(destination) ? { ok: false, reason: "invalidView", missing: [] } :
          this.streamState.request(body.seq, body.x, body.y, destination)
        this.syncStreamImages()
        this.sendStreamEnvelope("map.stream.state", {
          epoch: body.epoch, seq: body.seq, displayedSeq: this.streamState.position.seq,
          missing: result.missing, code: result.ok ? "ok" : result.reason
        })
      } else if (message.topic === "map.stream.close") {
        if (body.retain === true && this.streamState.visible) {
          var transfer = this.streamTransfer, page = this
          this.streamTransfer = null
          this.streamState.freeze().forEach(function (record) { page.retireCellFile(record.uri) })
          if (transfer && transfer.uri) this.retireCellFile(transfer.uri)
          this.syncStreamImages()
        } else this.resetStream()
      }
    }
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  syncStreamImages() {
    if (!this.streamState) return
    this.streamImages = this.streamState.images().map(function (item) {
      return { key: item.key, uri: item.uri,
        style: "left:" + item.x + "px;top:" + item.y + "px;opacity:" + item.opacity + ";" }
    })
    this.streamVisible = this.streamState.visible
    if (this.streamVisible && this.streamState.destination) this.applyDestination(this.streamState.destination)
    var page = this
    this.streamState.takeRetired().forEach(function (record) { page.retireCellFile(record.uri) })
  },

  streamImageComplete(key, uri) {
    if (!this.streamState) return
    var previous = this.streamState.position.seq
    var record = this.streamState.records().find(function (file) { return file.key === key && file.uri === uri })
    if (!this.streamState.decoded(key, uri)) return
    this.syncStreamImages()
    if (record && record.hash) this.sendStreamEnvelope("map.cell.decoded", {
      epoch: this.streamState.epoch, cell: key, sha256: record.hash
    })
    if (this.streamState.position.seq !== previous) {
      this.sendStreamEnvelope("map.stream.state", {
        epoch: this.streamState.epoch, seq: this.streamState.position.seq,
        displayedSeq: this.streamState.position.seq, missing: [], code: "ok"
      })
    }
  },

  streamImageError(key, uri) {
    if (!this.streamState || !this.streamState.failed(key, uri)) return
    this.syncStreamImages()
    this.retireCellFile(uri)
    this.sendStreamEnvelope("map.stream.state", {
      epoch: this.streamState.epoch, displayedSeq: this.streamState.position.seq,
      missing: [key], code: "decodeFailed"
    })
  },

  handleRenderPrepare(message) {
    var body = message.body
    var occupied = this.preparedRender || this.activeTransfer || this.pendingPublication ||
      (this.activeMapOperationID ? {} : null)
    var result = renderProtocol.validatePrepare(body, { prepared: occupied })
    if (!result.ok) {
      this.sendRenderReject(body, result.code)
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    result.prepared.previousNavigation = {
      arrowPath: this.navArrowPath,
      distance: this.navDistance,
      street: this.navStreet,
      status: this.navStatus,
      statusVisible: this.navStatusVisible
    }
    this.preparedRender = result.prepared
    this.preparedRender.preparedAt = Date.now()
    if (!this.confirmedMap) {
      if (result.prepared.preview) {
        this.navArrowPath = maneuverPath(result.prepared.preview)
        this.navDistance = this.formatDistance(result.prepared.preview.distanceM)
        this.navStreet = result.prepared.preview.street
      }
      this.navStatus = "LOADING MAP"
      this.navStatusVisible = true
    }
    this.sendEnvelope({
      v: 1,
      id: this.nextBandMessageID(),
      src: "band",
      type: "message",
      topic: "render.ready",
      body: {
        runId: result.prepared.runId,
        sceneId: result.prepared.sceneId,
        renderer: result.prepared.renderer,
        formatVersion: result.prepared.formatVersion,
        width: result.prepared.width,
        height: result.prepared.height,
        bytes: result.prepared.bytes,
        primitives: result.prepared.primitives
      }
    })
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  sendRenderReject(body, code) {
    var runId = renderProtocol.validIdentifier(body && body.runId) ? body.runId : ""
    var sceneId = renderProtocol.validIdentifier(body && body.sceneId) ? body.sceneId : ""
    this.sendEnvelope({
      v: 1,
      id: this.nextBandMessageID(),
      src: "band",
      type: "message",
      topic: "render.reject",
      body: { runId: runId, sceneId: sceneId, code: code }
    })
  },

  rejectUnpreparedAsset(message) {
    var body = message.body || {}
    this.sendAssetResult(this.safeAsset(body.asset), this.safeRun(body.run), "error", 0, "", "ASSET_PREPARE_REQUIRED")
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  receiveAssetMessage(message) {
    if (message.topic === "map.asset.begin") this.beginAsset(message)
    else if (message.topic === "map.asset.chunk") this.writeAssetChunk(message)
    else if (message.topic === "map.asset.end") this.endAsset(message)
    else this.failAsset(message, "ASSET_TOPIC_INVALID")
  },

  validInteger(value) {
    return typeof value === "number" && isFinite(value) && Math.floor(value) === value
  },

  formatDistance(distanceM) {
    if (distanceM < 1000) return distanceM + " m"
    return Math.round(distanceM / 100) / 10 + " km"
  },

  validRun(run) {
    return typeof run === "string" && run.length >= 1 && run.length <= 24 &&
      /^[a-z0-9-]+$/.test(run)
  },

  validBeginBody(body) {
    return this.isRouteCardBeginBody(body) && typeof body.asset === "string" &&
      /^nav-[0-9a-f]{16}$/.test(body.asset) &&
      renderProtocol.validateAssetBegin(body, this.preparedRender).ok &&
      body.mime === body.format && (body.mime === "image/png" || body.mime === "image/jpeg") && this.validRun(body.run)
  },

  beginAsset(message) {
    var page = this
    var body = message.body
    var epoch = this.lifecycleEpoch
    if (!this.validBeginBody(body)) {
      this.failAsset(message, "ASSET_BEGIN_INVALID")
      return
    }
    if (this.activeTransfer) {
      this.failAsset(message, "ASSET_BUSY")
      return
    }
    var extension = body.mime === "image/jpeg" ? ".jpg" : ".png"
    var baseURI = "internal://files/" + body.asset + extension
    var transferURI = this.confirmedMap && this.confirmedMap.uri === baseURI ?
      "internal://files/" + body.asset + "-" + body.scene + extension : baseURI
    var transfer = {
      asset: body.asset,
      bytes: body.bytes,
      width: body.width,
      height: body.height,
      mime: body.mime,
      sha256: body.sha256,
      run: body.run,
      routeCard: true,
      renderer: "raster",
      format: body.format,
      formatVersion: 1,
      primitives: 0,
      scene: body.scene,
      preparedAt: this.preparedRender ? this.preparedRender.preparedAt : 0,
      startedAt: Date.now(),
      uri: transferURI,
      digest: sha256Create(),
      buffer: new Uint8Array(body.bytes),
      receivedBytes: 0,
      pendingChunks: [],
      validatedAt: 0,
      renderStartedAt: 0
    }
    var activate = function () {
      if (!page.ownsMapOperation(message.id, epoch)) return
      page.activeTransfer = transfer
      page.succeedAsset(message.id)
    }
    var prepare = function () {
      if (!page.ownsMapOperation(message.id, epoch)) return
      if (page.pendingDeleteURIs.indexOf(transfer.uri) >= 0) {
        page.failAsset(message, "ASSET_BUSY")
        return
      }
      page.unconfirmedURI = transfer.uri
      page.unconfirmedTouched = false
      try {
        file.access({
          uri: transfer.uri,
          success: function () {
            if (!page.ownsMapOperation(message.id, epoch)) return
            var scheduled = page.scheduleDelete(transfer.uri, function () {
              if (!page.ownsMapOperation(message.id, epoch)) return
              page.unconfirmedTouched = true
              activate()
            }, function () {
              if (!page.ownsMapOperation(message.id, epoch)) return
              page.failAsset(message, "ASSET_DELETE_FAILED")
            })
            if (!scheduled && page.ownsMapOperation(message.id, epoch)) {
              page.failAsset(message, "ASSET_BUSY")
            }
          },
          fail: function () {
            if (!page.ownsMapOperation(message.id, epoch)) return
            activate()
          }
        })
      } catch (error) {
        if (page.ownsMapOperation(message.id, epoch)) page.failAsset(message, "ASSET_PREPARE_FAILED")
      }
    }
    if (this.retiredMapURI) {
      var retiredURI = this.retiredMapURI
      var scheduled = this.scheduleDelete(retiredURI, function () {
        if (page.retiredMapURI === retiredURI) page.retiredMapURI = ""
        prepare()
      }, function () {
        if (!page.ownsMapOperation(message.id, epoch)) return
        page.failAsset(message, "ASSET_DELETE_FAILED")
      })
      if (!scheduled && this.ownsMapOperation(message.id, epoch)) this.failAsset(message, "ASSET_BUSY")
      return
    }
    prepare()
  },

  decodeBase64(value) {
    return decodeBase64Bytes(value)
  },

  writeAssetChunk(message) {
    var transfer = this.activeTransfer
    var body = message.body
    if (!transfer) {
      this.failAsset(message, "ASSET_NO_TRANSFER")
      return
    }
    if (body.asset !== transfer.asset) {
      this.failAsset(message, "ASSET_MISMATCH")
      return
    }
    if (body.scene !== transfer.scene) {
      this.failAsset(message, "ASSET_SCENE_MISMATCH")
      return
    }
    if (body.run !== transfer.run) {
      this.failAsset(message, "ASSET_RUN_MISMATCH")
      return
    }
    if (!this.validInteger(body.offset) || body.offset < transfer.receivedBytes) {
      this.failAsset(message, "ASSET_OFFSET_INVALID")
      return
    }
    var buffer = this.decodeBase64(body.data)
    if (!buffer) {
      this.failAsset(message, "ASSET_BASE64_INVALID")
      return
    }
    if (body.offset + buffer.length > transfer.bytes) {
      this.failAsset(message, "ASSET_OVERFLOW")
      return
    }
    var chunkEnd = body.offset + buffer.length
    for (var index = 0; index < transfer.pendingChunks.length; index = index + 1) {
      var pending = transfer.pendingChunks[index]
      if (body.offset < pending.offset + pending.buffer.length && chunkEnd > pending.offset) {
        this.failAsset(message, "ASSET_OFFSET_INVALID")
        return
      }
    }
    if (body.offset > transfer.receivedBytes) {
      if (transfer.pendingChunks.length >= 3) {
        this.failAsset(message, "ASSET_OFFSET_INVALID")
        return
      }
      transfer.pendingChunks.push({ offset: body.offset, buffer: buffer })
      this.succeedAsset(message.id)
      return
    }
    transfer.buffer.set(buffer, body.offset)
    sha256Update(transfer.digest, buffer)
    transfer.receivedBytes = transfer.receivedBytes + buffer.length
    var appended = true
    while (appended) {
      appended = false
      for (index = 0; index < transfer.pendingChunks.length; index = index + 1) {
        pending = transfer.pendingChunks[index]
        if (pending.offset === transfer.receivedBytes) {
          transfer.buffer.set(pending.buffer, pending.offset)
          sha256Update(transfer.digest, pending.buffer)
          transfer.receivedBytes = transfer.receivedBytes + pending.buffer.length
          transfer.pendingChunks.splice(index, 1)
          appended = true
          break
        }
      }
    }
    this.lastReceivedBytes = transfer.receivedBytes
    this.succeedAsset(message.id)
  },

  endAsset(message) {
    var transfer = this.activeTransfer
    if (!transfer) {
      this.failAsset(message, "ASSET_NO_TRANSFER")
      return
    }
    if (message.body.asset !== transfer.asset) {
      this.failAsset(message, "ASSET_MISMATCH")
      return
    }
    if (message.body.scene !== transfer.scene) {
      this.failAsset(message, "ASSET_SCENE_MISMATCH")
      return
    }
    if (message.body.run !== transfer.run) {
      this.failAsset(message, "ASSET_RUN_MISMATCH")
      return
    }
    if (transfer.receivedBytes !== transfer.bytes) {
      this.failAsset(message, "ASSET_LENGTH_MISMATCH")
      return
    }
    var digest
    try {
      digest = sha256Finish(transfer.digest)
    } catch (error) {
      this.failAsset(message, "ASSET_HASH_FAILED")
      return
    }
    if (typeof digest !== "string" || digest.toLowerCase() !== transfer.sha256) {
      this.failAsset(message, "ASSET_DIGEST_MISMATCH")
      return
    }
    var page = this
    var epoch = this.lifecycleEpoch
    try {
      this.unconfirmedURI = transfer.uri
      this.unconfirmedTouched = true
      file.writeArrayBuffer({
        uri: transfer.uri,
        buffer: transfer.buffer,
        position: 0,
        success: function () {
          if (!page.ownsMapOperation(message.id, epoch) || page.activeTransfer !== transfer) return
          transfer.buffer = null
          page.publishWrittenAsset(message, transfer)
        },
        fail: function () {
          if (page.ownsMapOperation(message.id, epoch)) page.failAsset(message, "ASSET_WRITE_FAILED")
        }
      })
    } catch (error) {
      if (this.ownsMapOperation(message.id, epoch)) this.failAsset(message, "ASSET_WRITE_FAILED")
    }
  },

  publishWrittenAsset(message, transfer) {
    var asset = transfer.asset
    var bytes = transfer.bytes
    var prefix = transfer.sha256.slice(0, 8)
    transfer.validatedAt = Date.now()
    var token = "render-" + this.lifecycleEpoch + "-" + this.nextRenderToken
    this.nextRenderToken = this.nextRenderToken + 1
    this.pendingMapPath = transfer.uri
    this.pendingMapToken = token
    this.pendingPublication = {
      asset: asset,
      run: transfer.run,
      bytes: bytes,
      sha256Prefix: prefix,
      uri: transfer.uri,
      operationID: message.id,
      token: token,
      epoch: this.lifecycleEpoch,
      routeCard: transfer.routeCard,
      renderer: transfer.renderer,
      formatVersion: transfer.formatVersion,
      primitives: transfer.primitives,
      scene: transfer.scene,
      preparedAt: transfer.preparedAt,
      transferStartedAt: transfer.startedAt,
      validatedAt: transfer.validatedAt,
      renderStartedAt: Date.now(),
      preview: this.preparedRender ? this.preparedRender.preview : null
    }
    this.activeTransfer = null
    this.holdSuccessfulAsset(message.id)
  },

  removeInFlight(id) {
    var index = this.inFlightIDs.indexOf(id)
    if (index >= 0) this.inFlightIDs.splice(index, 1)
  },

  rememberSuccess(id) {
    this.recentIDs.push(id)
    if (this.recentIDs.length > this.MAX_RECENT_IDS) this.recentIDs.shift()
  },

  succeedAsset(id) {
    if (!this.releaseMapOperation(id)) return
    this.removeInFlight(id)
    this.rememberSuccess(id)
    this.sendACK(id)
  },

  ownsMapOperation(id, epoch) {
    return this.activeMapOperationID === id && this.lifecycleEpoch === epoch
  },

  holdSuccessfulAsset(id) {
    if (this.activeMapOperationID !== id) return
    this.removeInFlight(id)
    this.rememberSuccess(id)
    this.sendACK(id)
  },

  failAsset(message, code) {
    var transfer = this.activeTransfer
    var body = message && message.body ? message.body : {}
    var ownsOperation = this.activeMapOperationID === message.id
    var preservesTransfer = code === "ASSET_BUSY" || code === "ASSET_MISMATCH" ||
      code === "ASSET_RUN_MISMATCH" || code === "ASSET_NO_TRANSFER"
    var matchesTransfer = ownsOperation && transfer && !preservesTransfer &&
      body.asset === transfer.asset && this.validRun(body.run) && body.run === transfer.run
    if (matchesTransfer) {
      this.failCurrentTransfer(message, code, transfer)
      return
    }

    var owned = this.releaseMapOperation(message.id)
    if (!owned && code !== "ASSET_BUSY") return
    this.removeInFlight(message.id)
    if (owned && this.isRouteCardBeginBody(body)) this.restorePreparedNavigation()
    if (code === "ASSET_BUSY") {
      var rejectedAsset = this.safeAsset(message.body.asset)
      this.sendAssetResult(rejectedAsset, this.safeRun(message.body.run), "error", 0, "", code)
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    var asset = transfer ? transfer.asset : (typeof message.body.asset === "string" ? message.body.asset : "")
    var bytes = transfer ? transfer.receivedBytes : 0
    var prefix = transfer ? transfer.sha256.slice(0, 8) : ""
    var run = this.safeRun(message.body.run)
    this.sendAssetResult(asset, run, "error", bytes, prefix, code)
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  failCurrentTransfer(message, code, transfer) {
    var page = this
    var epoch = this.lifecycleEpoch
    var asset = transfer.asset
    var run = transfer.run
    var bytes = transfer.receivedBytes
    var prefix = transfer.sha256.slice(0, 8)
    if (transfer.routeCard) this.restorePreparedNavigation()
    this.activeTransfer = null
    this.unconfirmedURI = ""
    this.unconfirmedTouched = false
    if (!this.confirmedMap) {
      this.mapReady = false
      this.mapPath = ""
      this.mapHashPrefix = ""
      this.mapRenderer = ""
      this.mapToken = ""
      this.showDiagnostics = true
    }

    var publish = function () {
      if (!page.ownsMapOperation(message.id, epoch)) return
      if (!page.releaseMapOperation(message.id)) return
      page.removeInFlight(message.id)
      page.sendRenderResult(transfer, false, 0, code, bytes, prefix)
      page.rememberSuccess(message.id)
      page.sendACK(message.id)
    }
    if (!this.scheduleDelete(transfer.uri, publish, publish)) publish()
  },

  releaseMapOperation(id) {
    if (this.activeMapOperationID !== id) return false
    this.activeMapOperationID = ""
    return true
  },

  safeAsset(asset) {
    return typeof asset === "string" && /^nav-[0-9a-f]{16}$/.test(asset) ? asset : ""
  },

  safeRun(run) {
    return this.validRun(run) ? run : ""
  },

  invalidateConfirmedURI(uri) {
    if (!this.confirmedMap || this.confirmedMap.uri !== uri) return
    this.confirmedMap = null
    if (this.mapPath !== uri) return
    this.mapReady = false
    this.mapPath = ""
    this.mapHashPrefix = ""
    this.mapRenderer = ""
    this.mapToken = ""
    this.showDiagnostics = true
  },

  scheduleDelete(uri, success, fail) {
    if (typeof uri !== "string" || !uri || this.pendingDeleteURIs.indexOf(uri) >= 0) return false
    this.invalidateConfirmedURI(uri)
    this.pendingDeleteURIs.push(uri)
    var page = this
    var completed = false
    var finish = function (callback) {
      if (completed) return
      completed = true
      var index = page.pendingDeleteURIs.indexOf(uri)
      if (index >= 0) page.pendingDeleteURIs.splice(index, 1)
      if (callback) callback()
    }
    try {
      file.delete({
        uri: uri,
        success: function () { finish(success) },
        fail: function () { finish(fail) }
      })
    } catch (error) {
      finish(fail)
    }
    return true
  },

  deleteBestEffort(uri) {
    this.scheduleDelete(uri, null, null)
  },

  sendACK(id) {
    this.sendEnvelope({ v: 1, id: id, src: "band", type: "ack" })
  },

  sendAssetResult(asset, run, status, bytes, prefix, code) {
    var safeBytes = this.validInteger(bytes) && bytes >= 0 && bytes <= this.MAX_ASSET_BYTES ? bytes : 0
    var safePrefix = typeof prefix === "string" && /^[0-9a-f]{8}$/.test(prefix) ? prefix : ""
    var safeCode = typeof code === "string" && /^ASSET_[A-Z0-9_]{1,40}$/.test(code) ? code : ""
    var body = {
      asset: this.safeAsset(asset),
      run: this.safeRun(run),
      status: status === "ok" ? "ok" : "error",
      bytes: safeBytes,
      sha256Prefix: safePrefix
    }
    if (safeCode) body.code = safeCode
    var id = "b-" + Date.now() + "-" + this.nextID
    this.nextID = this.nextID + 1
    this.sendEnvelope({
      v: 1,
      id: id,
      src: "band",
      type: "message",
      topic: "map.asset.result",
      body: body
    })
  },

  sendRenderResult(publication, success, renderMs, errorCode) {
    if (!publication || !publication.routeCard) return
    var safeMilliseconds = function (value) {
      return typeof value === "number" && isFinite(value) && value >= 0 && value <= 60000 ? Math.floor(value) : 0
    }
    var start = publication.transferStartedAt || 0
    var prepared = publication.preparedAt || 0
    var validated = publication.validatedAt || 0
    var renderStarted = publication.renderStartedAt || 0
    var body = {
      runId: renderProtocol.validIdentifier(publication.run) ? publication.run : "",
      sceneId: renderProtocol.validIdentifier(publication.scene) ? publication.scene : "",
      renderer: "raster",
      formatVersion: publication.formatVersion === 1 ? 1 : 0,
      status: success === true ? "ok" : "error",
      bytes: publication.bytes,
      primitives: publication.primitives,
      prepareMs: safeMilliseconds(start - prepared),
      validateMs: safeMilliseconds(validated - start),
      renderMs: safeMilliseconds(renderMs || (Date.now() - renderStarted)),
      sha256Prefix: publication.sha256Prefix
    }
    if (!success && typeof errorCode === "string" && /^ASSET_[A-Z0-9_]{1,40}$/.test(errorCode)) {
      body.errorCode = errorCode
    }
    this.sendEnvelope({
      v: 1,
      id: this.nextBandMessageID(),
      src: "band",
      type: "message",
      topic: "render.result",
      body: body
    })
  },

  nextBandMessageID() {
    var id = "b-" + Date.now() + "-" + this.nextID
    this.nextID = this.nextID + 1
    return id
  },

  sendEnvelope(message) {
    if (!this.connected || !this.connection || !this.validEnvelope(message, "band")) return
    var page = this
    var ownedConnection = this.connection
    var epoch = this.lifecycleEpoch
    ownedConnection.send({
      data: message,
      fail: function (data, code) {
        if (!page.ownsConnectionEpoch(ownedConnection, epoch) ||
          !page.connected || !page.acceptingMessages) return
        var nativeCode = typeof code === "number" ? code : data && data.code
        page.lastSendCode = page.validInteger(nativeCode) && nativeCode >= 0 && nativeCode <= 65535 ? nativeCode : -1
        // A native send timeout is not a disconnect. Keep accepted chunks so
        // the phone's bounded exact-command retry can request the ACK again.
        if (page.lastSendCode === 204) return
        page.lock("SEND FAILED")
      }
    })
  },

  sendPing() {
    if (!this.connected) return
    var id = "b-" + Date.now() + "-" + this.nextID
    this.nextID = this.nextID + 1
    this.appendRow(id, "BAND > PING", true)
    this.sendEnvelope({
      v: 1,
      id: id,
      src: "band",
      type: "message",
      topic: "system.echo",
      body: { text: "PING" }
    })
  },

  appendRow(id, line, outgoing) {
    this.logRows.push({ id: id, line: line, outgoing: outgoing, acknowledged: false })
    if (this.logRows.length > 12) this.logRows.shift()
    this.renderLog()
  },

  acknowledge(id) {
    for (var index = 0; index < this.logRows.length; index = index + 1) {
      var row = this.logRows[index]
      if (row.id === id && row.outgoing) {
        row.acknowledged = true
        this.renderLog()
        return
      }
    }
  },

  renderLog() {
    var output = ""
    for (var index = 0; index < this.logRows.length; index = index + 1) {
      if (index > 0) output = output + "\n"
      output = output + this.logRows[index].line
      if (this.logRows[index].acknowledged) output = output + " ✓"
    }
    this.logText = output || "Echo ready."
  },

  clearEvents() {
    this.logRows = []
    this.logText = "Echo ready."
  },

  destinationDirection(markerX, markerY, destinationX, destinationY) {
    var angle = Math.atan2(destinationX - markerX, markerY - destinationY)
    return (Math.round(angle / (Math.PI / 4)) + 8) % 8
  },

  destinationOverlay(mode, x, y) {
    if (mode === "visible") {
      var point = safeMaskClamp(x, y, 28, 34, 6)
      return { path: "/common/destination-pin.png", style: "left:" + (point.x - 14) + "px;top:" + (point.y - 17) + "px;" }
    }
    var direction = this.destinationDirection(106, 374, x, y)
    return {
      path: "/common/destination-edge-" + direction + ".png",
      style: "left:" + (x - 12) + "px;top:" + (y - 12) + "px;width:24px;height:24px;"
    }
  },

  applyPreviewOverlay(preview) {
    if (!preview) {
      this.navMarkerVisible = false
      this.navDestinationVisible = false
      return
    }
    this.navMarkerVisible = true
    this.navMarkerPath = "/common/marker-cursor-v4.png"
    this.navMarkerStyle = "left:91px;top:355px;"
    this.applyDestination(preview)
  },

  applyDestination(preview) {
    this.navDestinationVisible = preview.destinationMode !== "hidden"
    if (this.navDestinationVisible) {
      var destination = this.destinationOverlay(
        preview.destinationMode, preview.destinationX, preview.destinationY
      )
      this.navDestinationPath = destination.path
      this.navDestinationStyle = destination.style
    }
  },

  mapComplete(token) {
    var publication = this.pendingPublication
    if (!publication || token !== publication.token || this.lifecycleEpoch !== publication.epoch ||
      this.activeMapOperationID !== publication.operationID || publication.cleanupStarted) return
    publication.cleanupStarted = true
    this.resetStream()
    var priorMap = this.confirmedMap
    this.unconfirmedURI = ""
    this.unconfirmedTouched = false
    this.confirmedMap = {
      uri: publication.uri,
      sha256Prefix: publication.sha256Prefix,
      token: publication.token,
      renderer: publication.renderer || "raster",
      scene: publication.scene || "",
      preview: publication.preview
    }
    this.mapPath = publication.uri
    this.mapHashPrefix = publication.sha256Prefix
    this.mapReady = true
    this.mapRenderer = publication.renderer || "raster"
    this.mapToken = publication.token
    this.pendingMapPath = ""
    this.pendingMapToken = ""
    this.showDiagnostics = false
    this.navScene = publication.scene || ""
    this.navSequence = -1
    if (!priorMap) {
      this.navStatus = "WAITING"
      this.navStatusVisible = false
    }
    this.applyPreviewOverlay(publication.preview)
    var page = this
    var publish = function () {
      if (page.pendingPublication !== publication || page.lifecycleEpoch !== publication.epoch ||
        page.activeMapOperationID !== publication.operationID) return
      page.pendingPublication = null
      if (!page.releaseMapOperation(publication.operationID)) return
      page.sendRenderResult(publication, true, Date.now() - publication.renderStartedAt, "")
      page.preparedRender = null
    }
    if (priorMap && priorMap.uri !== publication.uri) {
      var retiredURI = priorMap.uri
      this.retiredMapURI = retiredURI
      var finishRetirement = function (deleted) {
        if (deleted && page.retiredMapURI === retiredURI) page.retiredMapURI = ""
        publish()
      }
      if (!this.scheduleDelete(retiredURI, function () { finishRetirement(true) }, function () {
        finishRetirement(false)
      })) return
      return
    }
    publish()
  },

  mapError(token) {
    var publication = this.pendingPublication
    if (!publication || token !== publication.token || this.lifecycleEpoch !== publication.epoch ||
      this.activeMapOperationID !== publication.operationID || publication.cleanupStarted) return
    publication.cleanupStarted = true
    this.pendingMapPath = ""
    this.pendingMapToken = ""
    if (this.confirmedMap) {
      this.mapPath = this.confirmedMap.uri
      this.mapHashPrefix = this.confirmedMap.sha256Prefix
      this.mapReady = true
      this.mapRenderer = this.confirmedMap.renderer || "raster"
      this.mapToken = this.confirmedMap.token
    } else {
      this.mapReady = false
      this.mapPath = ""
      this.mapHashPrefix = ""
      this.mapRenderer = ""
      this.mapToken = ""
    }
    this.showDiagnostics = true
    this.logText = "Map image display failed."
    var page = this
    var publish = function () {
      if (page.pendingPublication !== publication || page.lifecycleEpoch !== publication.epoch ||
        page.activeMapOperationID !== publication.operationID) return
      page.pendingPublication = null
      page.unconfirmedURI = ""
      page.unconfirmedTouched = false
      if (!page.releaseMapOperation(publication.operationID)) return
      page.sendRenderResult(publication, false, Date.now() - publication.renderStartedAt, "ASSET_RENDER")
      page.restorePreparedNavigation()
    }
    this.scheduleDelete(publication.uri, publish, publish)
  }
}
</script>

<style>
.page { width: 212px; height: 520px; background-color: #07162b; }
.waiting, .connected { width: 212px; height: 520px; padding-top: 54px; flex-direction: column; align-items: center; }
.connected { padding-top: 0; position: relative; }
.mark { width: 72px; height: 72px; border-radius: 18px; justify-content: center; align-items: center; background-color: #168cff; }
.mark-text { font-size: 46px; font-weight: bold; color: #ffffff; }
.title { margin-top: 18px; font-size: 25px; font-weight: bold; color: #ffffff; }
.status { margin-top: 12px; font-size: 16px; font-weight: bold; color: #5dffb0; }
.online { position: absolute; left: 16px; top: 230px; width: 180px; font-size: 16px; font-weight: bold; text-align: center; color: #5dffb0; }
.detail { margin-top: 14px; width: 180px; height: 76px; font-size: 15px; lines: 4; text-align: center; color: #a9bdd6; }
.version { margin-top: 22px; font-size: 13px; color: #7897b8; }
.nav-header { position: absolute; left: 0; top: 0; width: 212px; height: 96px; }
.nav-arrow { position: absolute; left: 32px; top: 28px; width: 44px; height: 56px; }
.nav-distance { position: absolute; left: 78px; top: 26px; width: 88px; font-size: 26px; font-weight: bold; text-align: center; color: #ffffff; }
.nav-street { position: absolute; left: 72px; top: 60px; width: 100px; height: 22px; font-size: 14px; lines: 1; text-align: center; color: #ffffff; }
.nav-status { position: absolute; left: 72px; top: 80px; width: 94px; font-size: 10px; font-weight: bold; text-align: right; color: #5dffb0; }
.map-frame { width: 212px; height: 520px; position: relative; background-color: #050e16; }
.map { position: absolute; left: 0; top: 0; width: 212px; height: 520px; object-fit: contain; }
.stream-cell { position: absolute; width: 128px; height: 128px; object-fit: contain; }
.stream-attribution { position: absolute; left: 75px; top: 481px; width: 62px; height: 18px; font-size: 9px; text-align: center; color: #f4f3e5; }
.nav-destination { position: absolute; width: 28px; }
.nav-marker { position: absolute; width: 30px; height: 38px; object-fit: contain; }
</style>
