<template>
  <div class="page">
    <div class="waiting" if="{{ waiting }}">
      <div class="mark"><text class="mark-text">M</text></div>
      <text class="title">BLUEBAND MAP</text>
      <text class="status">{{ statusText }}</text>
      <text class="detail">{{ detailText }}</text>
      <input class="check" type="button" value="CHECK CONNECTION" @click="checkConnection" />
      <text class="version">RPK 0.3.0</text>
    </div>

    <div class="connected" if="{{ connected }}">
      <div class="map-frame" if="{{ mapReady || pendingPublication }}">
        <image class="map" if="{{ mapReady }}" src="{{ mapPath }}" />
        <image class="map map-pending" if="{{ pendingPublication }}" src="{{ pendingMapPath }}" @complete="mapComplete(pendingMapToken)" @error="mapError(pendingMapToken)" />
        <div class="nav-marker" if="{{ mapReady }}" style="{{ navMarkerStyle }}"></div>
      </div>
      <div class="nav-header" if="{{ mapReady || pendingPublication }}">
        <text class="nav-arrow">{{ navArrow }}</text>
        <text class="nav-distance">{{ navDistance }}</text>
        <text class="nav-street">{{ navStreet }}</text>
        <text class="nav-status" if="{{ navStatusVisible }}">{{ navStatus }}</text>
      </div>
      <text class="online" if="{{ !mapReady && !pendingPublication }}">{{ startupStatus }}</text>
      <div class="diagnostics" if="{{ showDiagnostics }}">
        <text class="log">{{ logText }}</text>
        <input class="button" type="button" value="ECHO PING" @click="sendPing" />
        <input class="clear" type="button" value="CLEAR EVENTS" @click="clearEvents" />
        <text class="version">RPK 0.3.0 • ENV V1</text>
      </div>
    </div>
  </div>
</template>

<script>
import interconnect from "@system.interconnect"
import file from "@system.file"

var base64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function decodeBase64Bytes(value) {
  if (typeof value !== "string" || value.length === 0 || value.length % 4 !== 0 ||
    !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) return null
  var padding = value.slice(-2) === "==" ? 2 : value.slice(-1) === "=" ? 1 : 0
  var output = new Uint8Array(value.length * 3 / 4 - padding)
  var accumulator = 0
  var bits = 0
  var outputIndex = 0
  for (var index = 0; index < value.length && value.charAt(index) !== "="; index = index + 1) {
    var sixBits = base64Alphabet.indexOf(value.charAt(index))
    if (sixBits < 0) return null
    accumulator = (accumulator << 6) | sixBits
    bits = bits + 6
    if (bits >= 8) {
      bits = bits - 8
      output[outputIndex] = (accumulator >>> bits) & 255
      outputIndex = outputIndex + 1
      accumulator = bits === 0 ? 0 : accumulator & ((1 << bits) - 1)
    }
  }
  return outputIndex === output.length ? output : null
}

var sha256Constants = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

function sha256Rotate(value, count) {
  return (value >>> count) | (value << (32 - count))
}

function sha256Block(context, block) {
  var words = context.words
  var index
  for (index = 0; index < 16; index = index + 1) {
    var offset = index * 4
    words[index] = (block[offset] << 24) | (block[offset + 1] << 16) |
      (block[offset + 2] << 8) | block[offset + 3]
  }
  for (index = 16; index < 64; index = index + 1) {
    var previous = words[index - 15]
    var prior = words[index - 2]
    var sigma0 = sha256Rotate(previous, 7) ^ sha256Rotate(previous, 18) ^ (previous >>> 3)
    var sigma1 = sha256Rotate(prior, 17) ^ sha256Rotate(prior, 19) ^ (prior >>> 10)
    words[index] = (words[index - 16] + sigma0 + words[index - 7] + sigma1) | 0
  }
  var a = context.state[0]
  var b = context.state[1]
  var c = context.state[2]
  var d = context.state[3]
  var e = context.state[4]
  var f = context.state[5]
  var g = context.state[6]
  var h = context.state[7]
  for (index = 0; index < 64; index = index + 1) {
    var sum1 = sha256Rotate(e, 6) ^ sha256Rotate(e, 11) ^ sha256Rotate(e, 25)
    var choice = (e & f) ^ (~e & g)
    var temporary1 = (h + sum1 + choice + sha256Constants[index] + words[index]) | 0
    var sum0 = sha256Rotate(a, 2) ^ sha256Rotate(a, 13) ^ sha256Rotate(a, 22)
    var majority = (a & b) ^ (a & c) ^ (b & c)
    var temporary2 = (sum0 + majority) | 0
    h = g
    g = f
    f = e
    e = (d + temporary1) | 0
    d = c
    c = b
    b = a
    a = (temporary1 + temporary2) | 0
  }
  context.state[0] = (context.state[0] + a) | 0
  context.state[1] = (context.state[1] + b) | 0
  context.state[2] = (context.state[2] + c) | 0
  context.state[3] = (context.state[3] + d) | 0
  context.state[4] = (context.state[4] + e) | 0
  context.state[5] = (context.state[5] + f) | 0
  context.state[6] = (context.state[6] + g) | 0
  context.state[7] = (context.state[7] + h) | 0
}

function sha256Create() {
  return {
    state: new Int32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
      0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]),
    block: new Uint8Array(64),
    words: new Int32Array(64),
    blockLength: 0,
    byteLength: 0
  }
}

function sha256Update(context, bytes) {
  context.byteLength = context.byteLength + bytes.length
  for (var index = 0; index < bytes.length; index = index + 1) {
    context.block[context.blockLength] = bytes[index]
    context.blockLength = context.blockLength + 1
    if (context.blockLength === 64) {
      sha256Block(context, context.block)
      context.blockLength = 0
    }
  }
}

function sha256Finish(context) {
  var bitLengthLow = (context.byteLength * 8) >>> 0
  var bitLengthHigh = Math.floor(context.byteLength / 0x20000000) >>> 0
  context.block[context.blockLength] = 0x80
  context.blockLength = context.blockLength + 1
  if (context.blockLength > 56) {
    while (context.blockLength < 64) context.block[context.blockLength++] = 0
    sha256Block(context, context.block)
    context.blockLength = 0
  }
  while (context.blockLength < 56) context.block[context.blockLength++] = 0
  for (var index = 0; index < 4; index = index + 1) {
    context.block[56 + index] = (bitLengthHigh >>> (24 - index * 8)) & 255
    context.block[60 + index] = (bitLengthLow >>> (24 - index * 8)) & 255
  }
  sha256Block(context, context.block)
  var digest = ""
  for (index = 0; index < 8; index = index + 1) {
    var word = (context.state[index] >>> 0).toString(16)
    digest = digest + "00000000".slice(word.length) + word
  }
  return digest
}

// Keep the Band entry self-contained. The Vela page loader is the most fragile
// part of this POC; importing pure helpers here creates a webpack module graph
// that is evaluated before the first frame is drawn. These ES5 helpers mirror
// the tested host-side modules without adding runtime imports to the RPK page.
var renderProtocolLimits = {
  envelopeBytes: 512,
  payloadBytes: 8192,
  width: 212,
  height: 520,
  maximumPrimitives: 0,
  formatVersion: 1,
  maximumIdentifierBytes: 24
}

function renderProtocolUTF8Length(value) {
  if (typeof value !== "string") return 0
  var length = 0
  for (var index = 0; index < value.length; index += 1) {
    var code = value.charCodeAt(index)
    if (code < 128) length += 1
    else if (code < 2048) length += 2
    else if (code >= 55296 && code <= 56319 && index + 1 < value.length) {
      index += 1
      length += 4
    } else length += 3
  }
  return length
}

function renderProtocolValidIdentifier(value) {
  return typeof value === "string" && renderProtocolUTF8Length(value) >= 1 &&
    renderProtocolUTF8Length(value) <= renderProtocolLimits.maximumIdentifierBytes && /^[\x20-\x7e]+$/.test(value)
}

function renderProtocolValidSHA256(value) {
  return typeof value === "string" && /^[0-9a-f]{64}$/.test(value)
}

function renderProtocolValidInteger(value) {
  return typeof value === "number" && isFinite(value) && Math.floor(value) === value
}

function renderProtocolReject(code) {
  return { ok: false, code: code }
}

function renderProtocolValidatePrepare(body, options) {
  options = options || {}
  if (options.prepared) return renderProtocolReject("busy")
  if (!body || typeof body !== "object" || Array.isArray(body)) return renderProtocolReject("unsupportedRenderer")
  if (body.renderer !== "raster") return renderProtocolReject("unsupportedRenderer")
  if (body.formatVersion !== renderProtocolLimits.formatVersion) return renderProtocolReject("unsupportedFormatVersion")
  if (body.format !== "image/png") {
    return renderProtocolReject("unsupportedFormatVersion")
  }
  if (body.width !== renderProtocolLimits.width || body.height !== renderProtocolLimits.height) {
    return renderProtocolReject("invalidDimensions")
  }
  if (!renderProtocolValidInteger(body.bytes) || body.bytes <= 0 || body.bytes > renderProtocolLimits.payloadBytes) {
    return renderProtocolReject("payloadTooLarge")
  }
  if (!renderProtocolValidInteger(body.primitives) || body.primitives < 0 || body.primitives > renderProtocolLimits.maximumPrimitives) {
    return renderProtocolReject("tooManyPrimitives")
  }
  if (!renderProtocolValidIdentifier(body.runId) || !renderProtocolValidIdentifier(body.sceneId) || !renderProtocolValidSHA256(body.sha256)) {
    return renderProtocolReject("unsupportedFormatVersion")
  }
  if (options.availableStorageBytes !== undefined && body.bytes > options.availableStorageBytes) {
    return renderProtocolReject("insufficientStorage")
  }
  return {
    ok: true,
    prepared: {
      runId: body.runId,
      sceneId: body.sceneId,
      renderer: body.renderer,
      format: body.format,
      formatVersion: body.formatVersion,
      width: body.width,
      height: body.height,
      bytes: body.bytes,
      sha256: body.sha256,
      primitives: body.primitives
    }
  }
}

function renderProtocolValidateAssetBegin(body, prepared) {
  if (!prepared) return renderProtocolReject("notPrepared")
  if (!body || typeof body !== "object" ||
    body.run !== prepared.runId || body.scene !== prepared.sceneId ||
    body.renderer !== prepared.renderer || body.formatVersion !== prepared.formatVersion ||
    body.width !== prepared.width || body.height !== prepared.height ||
    body.bytes !== prepared.bytes || body.sha256 !== prepared.sha256 ||
    body.primitives !== prepared.primitives || body.format !== prepared.format) {
    return renderProtocolReject("notPrepared")
  }
  return { ok: true }
}

var renderProtocol = {
  validIdentifier: renderProtocolValidIdentifier,
  validSHA256: renderProtocolValidSHA256,
  validatePrepare: renderProtocolValidatePrepare,
  validateAssetBegin: renderProtocolValidateAssetBegin
}

export default {
  private: {
    MAX_ENVELOPE_BYTES: 512,
    MAX_RECENT_IDS: 64,
    MAX_ASSET_BYTES: 8192,
    MAP_WIDTH: 212,
    MAP_HEIGHT: 520,
    connection: null,
    destroyed: false,
    acceptingMessages: false,
    waiting: true,
    connected: false,
    statusText: "PAGE READY",
    detailText: "Connect Band 10 in BlueBandMap on iPhone.",
    logText: "Echo ready.",
    logRows: [],
    recentIDs: [],
    inFlightIDs: [],
    lifecycleEpoch: 0,
    activeMapOperationID: "",
    pendingDeleteURIs: [],
    activeTransfer: null,
    unconfirmedURI: "",
    unconfirmedTouched: false,
    mapReady: false,
    mapPath: "",
    mapHashPrefix: "",
    mapRenderer: "",
    mapToken: "",
    navScene: "",
    navSequence: -1,
    navArrow: "↑",
    navDistance: "—",
    navStreet: "",
    navStatus: "WAITING",
    navStatusVisible: false,
    startupStatus: "IOS CONNECTED • WAITING ROUTE",
    navMarkerStyle: "left:102px;top:316px;",
    pendingPublication: null,
    pendingMapPath: "",
    pendingMapToken: "",
    preparedRender: null,
    confirmedMap: null,
    retiredMapURI: "",
    nextRenderToken: 1,
    showDiagnostics: true,
    nextID: 1
  },

  onReady() {
    this.destroyed = false
    this.acceptingMessages = false
    this.connected = false
    try {
      this.connection = interconnect.instance()
      this.bindConnectionHandlers(this.connection)
    } catch (error) {
      this.statusText = "INTERCONNECT ERROR"
      this.detailText = "Unable to start the system bridge."
    }
  },

  bindConnectionHandlers(connection) {
    if (!this.ownsConnection(connection)) return
    var page = this
    var epoch = this.lifecycleEpoch
    connection.onopen = function () {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.statusText = "IOS LINK OPEN"
      page.detailText = "Press CHECK CONNECTION."
    }
    connection.onclose = function () {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.lock("IOS LINK CLOSED")
    }
    connection.onerror = function () {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.lock("IOS LINK ERROR")
    }
    connection.onmessage = function (event) {
      if (!page.ownsConnectionEpoch(connection, epoch)) return
      page.receiveMessage(event)
    }
  },

  onDestroy() {
    if (this.destroyed) return
    this.destroyed = true
    this.acceptingMessages = false
    this.connected = false
    this.waiting = true
    this.resetMapLifecycle()
    if (!this.connection) return
    this.connection.onopen = null
    this.connection.onclose = null
    this.connection.onerror = null
    this.connection.onmessage = null
  },

  checkConnection() {
    if (this.destroyed) return
    if (!this.connection) {
      this.statusText = "NO INTERCONNECT API"
      return
    }
    var page = this
    var ownedConnection = this.connection
    var epoch = this.lifecycleEpoch
    ownedConnection.getReadyState({
      success: function (result) {
        if (!page.ownsConnectionEpoch(ownedConnection, epoch)) return
        if (result.status === 1) page.unlock(ownedConnection)
        else {
          page.statusText = "IOS NOT CONNECTED"
          page.detailText = "Ready state: " + result.status
        }
      },
      fail: function (result, code) {
        if (!page.ownsConnectionEpoch(ownedConnection, epoch)) return
        page.statusText = "CHECK FAILED"
        page.detailText = "Error code: " + code
      }
    })
  },

  unlock(connection) {
    var ownedConnection = connection || this.connection
    if (!this.ownsConnection(ownedConnection)) return
    var newSession = !this.connected
    this.waiting = false
    this.connected = true
    this.acceptingMessages = true
    this.bindConnectionHandlers(ownedConnection)
    this.logRows = []
    if (newSession) this.recentIDs = []
    this.logText = "Echo ready."
  },

  lock(reason) {
    if (this.destroyed) return
    this.acceptingMessages = false
    this.connected = false
    this.resetMapLifecycle()
    this.waiting = true
    this.statusText = reason
    this.detailText = "Reconnect on iPhone, then check again."
  },

  ownsConnection(connection) {
    return !this.destroyed && !!connection && this.connection === connection
  },

  ownsConnectionEpoch(connection, epoch) {
    return this.ownsConnection(connection) && this.lifecycleEpoch === epoch
  },

  resetMapLifecycle() {
    this.lifecycleEpoch = this.lifecycleEpoch + 1
    this.navScene = ""
    this.navSequence = -1
    this.navStatus = "WAITING"
    this.navStatusVisible = false
    this.startupStatus = "IOS CONNECTED • WAITING ROUTE"
    var cleanupURI = this.pendingPublication ? this.pendingPublication.uri :
      (this.activeTransfer ? this.activeTransfer.uri : this.unconfirmedURI)
    var preserveURI = this.confirmedMap ? this.confirmedMap.uri : ""
    var shouldDelete = cleanupURI && (cleanupURI !== preserveURI || this.unconfirmedTouched)
    this.activeMapOperationID = ""
    this.inFlightIDs = []
    this.activeTransfer = null
    this.pendingPublication = null
    this.pendingMapPath = ""
    this.pendingMapToken = ""
    this.preparedRender = null
    this.unconfirmedURI = ""
    this.unconfirmedTouched = false
    if (this.confirmedMap) {
      this.mapPath = this.confirmedMap.uri
      this.mapHashPrefix = this.confirmedMap.sha256Prefix
      this.mapReady = true
      this.mapRenderer = this.confirmedMap.renderer || "raster"
      this.mapToken = this.confirmedMap.token
    } else {
      this.mapPath = ""
      this.mapHashPrefix = ""
      this.mapRenderer = ""
      this.mapReady = false
      this.mapToken = ""
      this.showDiagnostics = true
    }
    if (shouldDelete) this.deleteBestEffort(cleanupURI)
  },

  utf8Length(text) {
    var length = 0
    for (var index = 0; index < text.length; index = index + 1) {
      var code = text.charCodeAt(index)
      if (code < 128) length = length + 1
      else if (code < 2048) length = length + 2
      else if (code >= 55296 && code <= 56319 && index + 1 < text.length) {
        index = index + 1
        length = length + 4
      } else length = length + 3
    }
    return length
  },

  validID(id) {
    if (typeof id !== "string" || id.length < 1 || id.length > 32) return false
    for (var index = 0; index < id.length; index = index + 1) {
      var code = id.charCodeAt(index)
      if (code < 32 || code > 126) return false
    }
    return true
  },

  validTopic(topic) {
    return typeof topic === "string" && topic.length >= 1 && topic.length <= 64 &&
      /^[a-z0-9-]+(\.[a-z0-9-]+)*$/.test(topic)
  },

  validBody(body) {
    return body !== null && typeof body === "object" && !Array.isArray(body)
  },

  validEnvelope(message, source) {
    if (!message || message.v !== 1 || message.src !== source || !this.validID(message.id)) return false
    var encoded
    try { encoded = JSON.stringify(message) } catch (error) { return false }
    if (this.utf8Length(encoded) > this.MAX_ENVELOPE_BYTES) return false
    if (message.type === "ack") return message.topic === undefined && message.body === undefined
    if (message.type !== "message") return false
    return this.validTopic(message.topic) && this.validBody(message.body)
  },

  receiveMessage(event) {
    if (this.destroyed || !this.connected || !this.acceptingMessages) return
    var message = event
    if (event && event.data !== undefined) message = event.data
    if (typeof message === "string") {
      try { message = JSON.parse(message) } catch (error) { return }
    }
    if (!this.validEnvelope(message, "ios")) return
    if (message.type === "ack") {
      this.acknowledge(message.id)
      return
    }

    if (this.recentIDs.indexOf(message.id) >= 0) {
      this.sendACK(message.id)
      return
    }
    if (this.inFlightIDs.indexOf(message.id) >= 0) return
    if (message.topic === "nav.update") {
      this.handleNavigationUpdate(message)
      return
    }
    if (message.topic === "nav.status") {
      var startupLabels = { locating: "LOCATING", gpsLow: "GPS LOW" }
      if (message.body && startupLabels[message.body.status]) this.startupStatus = startupLabels[message.body.status]
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    if (message.topic === "render.prepare") {
      this.handleRenderPrepare(message)
      return
    }
    if (message.topic === "render.cancel") {
      var cancelled = message.body && this.preparedRender &&
        message.body.runId === this.preparedRender.runId && message.body.sceneId === this.preparedRender.sceneId
      if (cancelled) this.preparedRender = null
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    if (message.topic.indexOf("map.asset.") === 0) {
      if (this.activeMapOperationID) {
        this.failAsset(message, "ASSET_BUSY")
        return
      }
      if (message.topic === "map.asset.begin") {
        var admission = renderProtocol.validateAssetBegin(message.body, this.preparedRender)
        if (!admission.ok) {
          this.rejectUnpreparedAsset(message)
          return
        }
      }
      this.activeMapOperationID = message.id
      this.inFlightIDs.push(message.id)
      try { this.receiveAssetMessage(message) } catch (error) {
        this.failAsset(message, "ASSET_OPERATION_FAILED")
      }
      return
    }
    if (message.topic === "system.echo") {
      var text = typeof message.body.text === "string" ? message.body.text : "(object)"
      this.appendRow(message.id, "IOS > " + text, false)
    }
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  isRouteCardBeginBody(body) {
    return !!body && (body.renderer !== undefined || body.format !== undefined ||
      body.scene !== undefined || body.formatVersion !== undefined)
  },

  handleNavigationUpdate(message) {
    var body = message.body
    var maneuvers = ["straight", "left", "right", "uTurn", "roundabout", "arrive"]
    var statuses = ["navigating", "gpsLow", "limitedMap", "rerouting", "arrived"]
    var currentScene = this.confirmedMap && this.confirmedMap.scene
    var valid = body && body.scene === currentScene && this.validInteger(body.seq) && body.seq > this.navSequence &&
      this.validInteger(body.x) && body.x >= 0 && body.x < this.MAP_WIDTH &&
      this.validInteger(body.y) && body.y >= 0 && body.y < this.MAP_HEIGHT &&
      this.validInteger(body.distanceM) && body.distanceM >= 0 &&
      typeof body.street === "string" && this.utf8Length(body.street) <= 48 &&
      maneuvers.indexOf(body.maneuver) >= 0 && statuses.indexOf(body.status) >= 0
    if (valid) {
      var arrows = { straight: "↑", left: "←", right: "→", uTurn: "↶", roundabout: "↻", arrive: "●" }
      var labels = { navigating: "NAVIGATING", gpsLow: "GPS LOW", limitedMap: "LIMITED MAP", rerouting: "REROUTING", arrived: "ARRIVED" }
      this.navScene = body.scene
      this.navSequence = body.seq
      this.navArrow = arrows[body.maneuver]
      this.navDistance = body.status === "arrived" ? "ARRIVED" : body.distanceM + " m"
      this.navStreet = body.street
      this.navStatus = labels[body.status]
      this.navStatusVisible = body.status !== "navigating"
      this.navMarkerStyle = "left:" + Math.max(0, Math.min(202, body.x - 5)) + "px;top:" +
        Math.max(0, Math.min(510, body.y - 5)) + "px;"
    }
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  handleRenderPrepare(message) {
    var body = message.body
    var occupied = this.preparedRender || this.activeTransfer || this.pendingPublication ||
      (this.activeMapOperationID ? {} : null)
    var result = renderProtocol.validatePrepare(body, { prepared: occupied })
    if (!result.ok) {
      this.sendRenderReject(body, result.code)
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    this.preparedRender = result.prepared
    this.preparedRender.preparedAt = Date.now()
    this.navStatus = "LOADING MAP"
    this.navStatusVisible = true
    this.sendEnvelope({
      v: 1,
      id: this.nextBandMessageID(),
      src: "band",
      type: "message",
      topic: "render.ready",
      body: {
        runId: result.prepared.runId,
        sceneId: result.prepared.sceneId,
        renderer: result.prepared.renderer,
        formatVersion: result.prepared.formatVersion,
        width: result.prepared.width,
        height: result.prepared.height,
        bytes: result.prepared.bytes,
        primitives: result.prepared.primitives
      }
    })
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  sendRenderReject(body, code) {
    var runId = renderProtocol.validIdentifier(body && body.runId) ? body.runId : ""
    var sceneId = renderProtocol.validIdentifier(body && body.sceneId) ? body.sceneId : ""
    this.sendEnvelope({
      v: 1,
      id: this.nextBandMessageID(),
      src: "band",
      type: "message",
      topic: "render.reject",
      body: { runId: runId, sceneId: sceneId, code: code }
    })
  },

  rejectUnpreparedAsset(message) {
    var body = message.body || {}
    this.sendAssetResult(this.safeAsset(body.asset), this.safeRun(body.run), "error", 0, "", "ASSET_PREPARE_REQUIRED")
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  receiveAssetMessage(message) {
    if (message.topic === "map.asset.begin") this.beginAsset(message)
    else if (message.topic === "map.asset.chunk") this.writeAssetChunk(message)
    else if (message.topic === "map.asset.end") this.endAsset(message)
    else this.failAsset(message, "ASSET_TOPIC_INVALID")
  },

  validInteger(value) {
    return typeof value === "number" && isFinite(value) && Math.floor(value) === value
  },

  validRun(run) {
    return typeof run === "string" && run.length >= 1 && run.length <= 24 &&
      /^[a-z0-9-]+$/.test(run)
  },

  validBeginBody(body) {
    return this.isRouteCardBeginBody(body) && typeof body.asset === "string" &&
      /^nav-[0-9a-f]{16}$/.test(body.asset) &&
      renderProtocol.validateAssetBegin(body, this.preparedRender).ok &&
      body.mime === body.format && body.mime === "image/png" && this.validRun(body.run)
  },

  beginAsset(message) {
    var page = this
    var body = message.body
    var epoch = this.lifecycleEpoch
    if (!this.validBeginBody(body)) {
      this.failAsset(message, "ASSET_BEGIN_INVALID")
      return
    }
    if (this.activeTransfer) {
      this.failAsset(message, "ASSET_BUSY")
      return
    }
    var baseURI = "internal://files/" + body.asset + ".png"
    var transferURI = this.confirmedMap && this.confirmedMap.uri === baseURI ?
      "internal://files/" + body.asset + "-" + body.scene + ".png" : baseURI
    var transfer = {
      asset: body.asset,
      bytes: body.bytes,
      width: body.width,
      height: body.height,
      mime: body.mime,
      sha256: body.sha256,
      run: body.run,
      routeCard: true,
      renderer: "raster",
      format: "image/png",
      formatVersion: 1,
      primitives: 0,
      scene: body.scene,
      preparedAt: this.preparedRender ? this.preparedRender.preparedAt : 0,
      startedAt: Date.now(),
      uri: transferURI,
      digest: sha256Create(),
      buffer: new Uint8Array(body.bytes),
      receivedBytes: 0,
      validatedAt: 0,
      renderStartedAt: 0
    }
    var activate = function () {
      if (!page.ownsMapOperation(message.id, epoch)) return
      page.activeTransfer = transfer
      page.succeedAsset(message.id)
    }
    var prepare = function () {
      if (!page.ownsMapOperation(message.id, epoch)) return
      if (page.pendingDeleteURIs.indexOf(transfer.uri) >= 0) {
        page.failAsset(message, "ASSET_BUSY")
        return
      }
      page.unconfirmedURI = transfer.uri
      page.unconfirmedTouched = false
      try {
        file.access({
          uri: transfer.uri,
          success: function () {
            if (!page.ownsMapOperation(message.id, epoch)) return
            var scheduled = page.scheduleDelete(transfer.uri, function () {
              if (!page.ownsMapOperation(message.id, epoch)) return
              page.unconfirmedTouched = true
              activate()
            }, function () {
              if (!page.ownsMapOperation(message.id, epoch)) return
              page.failAsset(message, "ASSET_DELETE_FAILED")
            })
            if (!scheduled && page.ownsMapOperation(message.id, epoch)) {
              page.failAsset(message, "ASSET_BUSY")
            }
          },
          fail: function () {
            if (!page.ownsMapOperation(message.id, epoch)) return
            activate()
          }
        })
      } catch (error) {
        if (page.ownsMapOperation(message.id, epoch)) page.failAsset(message, "ASSET_PREPARE_FAILED")
      }
    }
    if (this.retiredMapURI) {
      var retiredURI = this.retiredMapURI
      var scheduled = this.scheduleDelete(retiredURI, function () {
        if (page.retiredMapURI === retiredURI) page.retiredMapURI = ""
        prepare()
      }, function () {
        if (!page.ownsMapOperation(message.id, epoch)) return
        page.failAsset(message, "ASSET_DELETE_FAILED")
      })
      if (!scheduled && this.ownsMapOperation(message.id, epoch)) this.failAsset(message, "ASSET_BUSY")
      return
    }
    prepare()
  },

  decodeBase64(value) {
    return decodeBase64Bytes(value)
  },

  writeAssetChunk(message) {
    var transfer = this.activeTransfer
    var body = message.body
    if (!transfer) {
      this.failAsset(message, "ASSET_NO_TRANSFER")
      return
    }
    if (body.asset !== transfer.asset) {
      this.failAsset(message, "ASSET_MISMATCH")
      return
    }
    if (body.scene !== transfer.scene) {
      this.failAsset(message, "ASSET_SCENE_MISMATCH")
      return
    }
    if (body.run !== transfer.run) {
      this.failAsset(message, "ASSET_RUN_MISMATCH")
      return
    }
    if (!this.validInteger(body.offset) || body.offset !== transfer.receivedBytes) {
      this.failAsset(message, "ASSET_OFFSET_INVALID")
      return
    }
    var buffer = this.decodeBase64(body.data)
    if (!buffer) {
      this.failAsset(message, "ASSET_BASE64_INVALID")
      return
    }
    if (transfer.receivedBytes + buffer.length > transfer.bytes) {
      this.failAsset(message, "ASSET_OVERFLOW")
      return
    }
    transfer.buffer.set(buffer, body.offset)
    sha256Update(transfer.digest, buffer)
    transfer.receivedBytes = transfer.receivedBytes + buffer.length
    this.succeedAsset(message.id)
  },

  endAsset(message) {
    var transfer = this.activeTransfer
    if (!transfer) {
      this.failAsset(message, "ASSET_NO_TRANSFER")
      return
    }
    if (message.body.asset !== transfer.asset) {
      this.failAsset(message, "ASSET_MISMATCH")
      return
    }
    if (message.body.scene !== transfer.scene) {
      this.failAsset(message, "ASSET_SCENE_MISMATCH")
      return
    }
    if (message.body.run !== transfer.run) {
      this.failAsset(message, "ASSET_RUN_MISMATCH")
      return
    }
    if (transfer.receivedBytes !== transfer.bytes) {
      this.failAsset(message, "ASSET_LENGTH_MISMATCH")
      return
    }
    var digest
    try {
      digest = sha256Finish(transfer.digest)
    } catch (error) {
      this.failAsset(message, "ASSET_HASH_FAILED")
      return
    }
    if (typeof digest !== "string" || digest.toLowerCase() !== transfer.sha256) {
      this.failAsset(message, "ASSET_DIGEST_MISMATCH")
      return
    }
    var page = this
    var epoch = this.lifecycleEpoch
    try {
      this.unconfirmedURI = transfer.uri
      this.unconfirmedTouched = true
      file.writeArrayBuffer({
        uri: transfer.uri,
        buffer: transfer.buffer,
        position: 0,
        success: function () {
          if (!page.ownsMapOperation(message.id, epoch) || page.activeTransfer !== transfer) return
          transfer.buffer = null
          page.publishWrittenAsset(message, transfer)
        },
        fail: function () {
          if (page.ownsMapOperation(message.id, epoch)) page.failAsset(message, "ASSET_WRITE_FAILED")
        }
      })
    } catch (error) {
      if (this.ownsMapOperation(message.id, epoch)) this.failAsset(message, "ASSET_WRITE_FAILED")
    }
  },

  publishWrittenAsset(message, transfer) {
    var asset = transfer.asset
    var bytes = transfer.bytes
    var prefix = transfer.sha256.slice(0, 8)
    transfer.validatedAt = Date.now()
    var token = "render-" + this.lifecycleEpoch + "-" + this.nextRenderToken
    this.nextRenderToken = this.nextRenderToken + 1
    this.pendingMapPath = transfer.uri
    this.pendingMapToken = token
    this.pendingPublication = {
      asset: asset,
      run: transfer.run,
      bytes: bytes,
      sha256Prefix: prefix,
      uri: transfer.uri,
      operationID: message.id,
      token: token,
      epoch: this.lifecycleEpoch,
      routeCard: transfer.routeCard,
      renderer: transfer.renderer,
      formatVersion: transfer.formatVersion,
      primitives: transfer.primitives,
      scene: transfer.scene,
      preparedAt: transfer.preparedAt,
      transferStartedAt: transfer.startedAt,
      validatedAt: transfer.validatedAt,
      renderStartedAt: Date.now()
    }
    this.activeTransfer = null
    this.holdSuccessfulAsset(message.id)
  },

  removeInFlight(id) {
    var index = this.inFlightIDs.indexOf(id)
    if (index >= 0) this.inFlightIDs.splice(index, 1)
  },

  rememberSuccess(id) {
    this.recentIDs.push(id)
    if (this.recentIDs.length > this.MAX_RECENT_IDS) this.recentIDs.shift()
  },

  succeedAsset(id) {
    if (!this.releaseMapOperation(id)) return
    this.removeInFlight(id)
    this.rememberSuccess(id)
    this.sendACK(id)
  },

  ownsMapOperation(id, epoch) {
    return this.activeMapOperationID === id && this.lifecycleEpoch === epoch
  },

  holdSuccessfulAsset(id) {
    if (this.activeMapOperationID !== id) return
    this.removeInFlight(id)
    this.rememberSuccess(id)
    this.sendACK(id)
  },

  failAsset(message, code) {
    var transfer = this.activeTransfer
    var body = message && message.body ? message.body : {}
    var ownsOperation = this.activeMapOperationID === message.id
    var preservesTransfer = code === "ASSET_BUSY" || code === "ASSET_MISMATCH" ||
      code === "ASSET_RUN_MISMATCH" || code === "ASSET_NO_TRANSFER"
    var matchesTransfer = ownsOperation && transfer && !preservesTransfer &&
      body.asset === transfer.asset && this.validRun(body.run) && body.run === transfer.run
    if (matchesTransfer) {
      this.failCurrentTransfer(message, code, transfer)
      return
    }

    var owned = this.releaseMapOperation(message.id)
    if (!owned && code !== "ASSET_BUSY") return
    this.removeInFlight(message.id)
    if (owned && this.isRouteCardBeginBody(body)) this.preparedRender = null
    if (code === "ASSET_BUSY") {
      var rejectedAsset = this.safeAsset(message.body.asset)
      this.sendAssetResult(rejectedAsset, this.safeRun(message.body.run), "error", 0, "", code)
      this.rememberSuccess(message.id)
      this.sendACK(message.id)
      return
    }
    var asset = transfer ? transfer.asset : (typeof message.body.asset === "string" ? message.body.asset : "")
    var bytes = transfer ? transfer.receivedBytes : 0
    var prefix = transfer ? transfer.sha256.slice(0, 8) : ""
    var run = this.safeRun(message.body.run)
    this.sendAssetResult(asset, run, "error", bytes, prefix, code)
    this.rememberSuccess(message.id)
    this.sendACK(message.id)
  },

  failCurrentTransfer(message, code, transfer) {
    var page = this
    var epoch = this.lifecycleEpoch
    var asset = transfer.asset
    var run = transfer.run
    var bytes = transfer.receivedBytes
    var prefix = transfer.sha256.slice(0, 8)
    if (transfer.routeCard) this.preparedRender = null
    this.activeTransfer = null
    this.unconfirmedURI = ""
    this.unconfirmedTouched = false
    if (!this.confirmedMap) {
      this.mapReady = false
      this.mapPath = ""
      this.mapHashPrefix = ""
      this.mapRenderer = ""
      this.mapToken = ""
      this.showDiagnostics = true
    }

    var publish = function () {
      if (!page.ownsMapOperation(message.id, epoch)) return
      if (!page.releaseMapOperation(message.id)) return
      page.removeInFlight(message.id)
      page.sendRenderResult(transfer, false, 0, code, bytes, prefix)
      page.rememberSuccess(message.id)
      page.sendACK(message.id)
    }
    if (!this.scheduleDelete(transfer.uri, publish, publish)) publish()
  },

  releaseMapOperation(id) {
    if (this.activeMapOperationID !== id) return false
    this.activeMapOperationID = ""
    return true
  },

  safeAsset(asset) {
    return typeof asset === "string" && /^nav-[0-9a-f]{16}$/.test(asset) ? asset : ""
  },

  safeRun(run) {
    return this.validRun(run) ? run : ""
  },

  invalidateConfirmedURI(uri) {
    if (!this.confirmedMap || this.confirmedMap.uri !== uri) return
    this.confirmedMap = null
    if (this.mapPath !== uri) return
    this.mapReady = false
    this.mapPath = ""
    this.mapHashPrefix = ""
    this.mapRenderer = ""
    this.mapToken = ""
    this.showDiagnostics = true
  },

  scheduleDelete(uri, success, fail) {
    if (typeof uri !== "string" || !uri || this.pendingDeleteURIs.indexOf(uri) >= 0) return false
    this.invalidateConfirmedURI(uri)
    this.pendingDeleteURIs.push(uri)
    var page = this
    var completed = false
    var finish = function (callback) {
      if (completed) return
      completed = true
      var index = page.pendingDeleteURIs.indexOf(uri)
      if (index >= 0) page.pendingDeleteURIs.splice(index, 1)
      if (callback) callback()
    }
    try {
      file.delete({
        uri: uri,
        success: function () { finish(success) },
        fail: function () { finish(fail) }
      })
    } catch (error) {
      finish(fail)
    }
    return true
  },

  deleteBestEffort(uri) {
    this.scheduleDelete(uri, null, null)
  },

  sendACK(id) {
    this.sendEnvelope({ v: 1, id: id, src: "band", type: "ack" })
  },

  sendAssetResult(asset, run, status, bytes, prefix, code) {
    var safeBytes = this.validInteger(bytes) && bytes >= 0 && bytes <= this.MAX_ASSET_BYTES ? bytes : 0
    var safePrefix = typeof prefix === "string" && /^[0-9a-f]{8}$/.test(prefix) ? prefix : ""
    var safeCode = typeof code === "string" && /^ASSET_[A-Z0-9_]{1,40}$/.test(code) ? code : ""
    var body = {
      asset: this.safeAsset(asset),
      run: this.safeRun(run),
      status: status === "ok" ? "ok" : "error",
      bytes: safeBytes,
      sha256Prefix: safePrefix
    }
    if (safeCode) body.code = safeCode
    var id = "b-" + Date.now() + "-" + this.nextID
    this.nextID = this.nextID + 1
    this.sendEnvelope({
      v: 1,
      id: id,
      src: "band",
      type: "message",
      topic: "map.asset.result",
      body: body
    })
  },

  sendRenderResult(publication, success, renderMs, errorCode) {
    if (!publication || !publication.routeCard) return
    var safeMilliseconds = function (value) {
      return typeof value === "number" && isFinite(value) && value >= 0 && value <= 60000 ? Math.floor(value) : 0
    }
    var start = publication.transferStartedAt || 0
    var prepared = publication.preparedAt || 0
    var validated = publication.validatedAt || 0
    var renderStarted = publication.renderStartedAt || 0
    var body = {
      runId: renderProtocol.validIdentifier(publication.run) ? publication.run : "",
      sceneId: renderProtocol.validIdentifier(publication.scene) ? publication.scene : "",
      renderer: "raster",
      formatVersion: publication.formatVersion === 1 ? 1 : 0,
      status: success === true ? "ok" : "error",
      bytes: publication.bytes,
      primitives: publication.primitives,
      prepareMs: safeMilliseconds(start - prepared),
      validateMs: safeMilliseconds(validated - start),
      renderMs: safeMilliseconds(renderMs || (Date.now() - renderStarted)),
      sha256Prefix: publication.sha256Prefix
    }
    if (!success && typeof errorCode === "string" && /^ASSET_[A-Z0-9_]{1,40}$/.test(errorCode)) {
      body.errorCode = errorCode
    }
    this.sendEnvelope({
      v: 1,
      id: this.nextBandMessageID(),
      src: "band",
      type: "message",
      topic: "render.result",
      body: body
    })
  },

  nextBandMessageID() {
    var id = "b-" + Date.now() + "-" + this.nextID
    this.nextID = this.nextID + 1
    return id
  },

  sendEnvelope(message) {
    if (!this.connected || !this.connection || !this.validEnvelope(message, "band")) return
    var page = this
    var ownedConnection = this.connection
    var epoch = this.lifecycleEpoch
    ownedConnection.send({
      data: message,
      fail: function () {
        if (!page.ownsConnectionEpoch(ownedConnection, epoch) ||
          !page.connected || !page.acceptingMessages) return
        page.lock("SEND FAILED")
      }
    })
  },

  sendPing() {
    if (!this.connected) return
    var id = "b-" + Date.now() + "-" + this.nextID
    this.nextID = this.nextID + 1
    this.appendRow(id, "BAND > PING", true)
    this.sendEnvelope({
      v: 1,
      id: id,
      src: "band",
      type: "message",
      topic: "system.echo",
      body: { text: "PING" }
    })
  },

  appendRow(id, line, outgoing) {
    this.logRows.push({ id: id, line: line, outgoing: outgoing, acknowledged: false })
    if (this.logRows.length > 12) this.logRows.shift()
    this.renderLog()
  },

  acknowledge(id) {
    for (var index = 0; index < this.logRows.length; index = index + 1) {
      var row = this.logRows[index]
      if (row.id === id && row.outgoing) {
        row.acknowledged = true
        this.renderLog()
        return
      }
    }
  },

  renderLog() {
    var output = ""
    for (var index = 0; index < this.logRows.length; index = index + 1) {
      if (index > 0) output = output + "\n"
      output = output + this.logRows[index].line
      if (this.logRows[index].acknowledged) output = output + " ✓"
    }
    this.logText = output || "Echo ready."
  },

  clearEvents() {
    this.logRows = []
    this.logText = "Echo ready."
  },

  mapComplete(token) {
    var publication = this.pendingPublication
    if (!publication || token !== publication.token || this.lifecycleEpoch !== publication.epoch ||
      this.activeMapOperationID !== publication.operationID || publication.cleanupStarted) return
    publication.cleanupStarted = true
    var priorMap = this.confirmedMap
    this.unconfirmedURI = ""
    this.unconfirmedTouched = false
    this.confirmedMap = {
      uri: publication.uri,
      sha256Prefix: publication.sha256Prefix,
      token: publication.token,
      renderer: publication.renderer || "raster",
      scene: publication.scene || ""
    }
    this.mapPath = publication.uri
    this.mapHashPrefix = publication.sha256Prefix
    this.mapReady = true
    this.mapRenderer = publication.renderer || "raster"
    this.mapToken = publication.token
    this.pendingMapPath = ""
    this.pendingMapToken = ""
    this.showDiagnostics = false
    this.navScene = publication.scene || ""
    this.navSequence = -1
    this.navArrow = "↑"
    this.navDistance = "—"
    this.navStreet = ""
    this.navStatus = "WAITING"
    this.navStatusVisible = false
    this.navMarkerStyle = "left:102px;top:370px;"
    this.statusText = "ROUTE CARD READY"
    var page = this
    var publish = function () {
      if (page.pendingPublication !== publication || page.lifecycleEpoch !== publication.epoch ||
        page.activeMapOperationID !== publication.operationID) return
      page.pendingPublication = null
      if (!page.releaseMapOperation(publication.operationID)) return
      page.sendRenderResult(publication, true, Date.now() - publication.renderStartedAt, "")
      page.preparedRender = null
    }
    if (priorMap && priorMap.uri !== publication.uri) {
      var retiredURI = priorMap.uri
      this.retiredMapURI = retiredURI
      var finishRetirement = function (deleted) {
        if (deleted && page.retiredMapURI === retiredURI) page.retiredMapURI = ""
        publish()
      }
      if (!this.scheduleDelete(retiredURI, function () { finishRetirement(true) }, function () {
        finishRetirement(false)
      })) return
      return
    }
    publish()
  },

  mapError(token) {
    var publication = this.pendingPublication
    if (!publication || token !== publication.token || this.lifecycleEpoch !== publication.epoch ||
      this.activeMapOperationID !== publication.operationID || publication.cleanupStarted) return
    publication.cleanupStarted = true
    this.pendingMapPath = ""
    this.pendingMapToken = ""
    if (this.confirmedMap) {
      this.mapPath = this.confirmedMap.uri
      this.mapHashPrefix = this.confirmedMap.sha256Prefix
      this.mapReady = true
      this.mapRenderer = this.confirmedMap.renderer || "raster"
      this.mapToken = this.confirmedMap.token
    } else {
      this.mapReady = false
      this.mapPath = ""
      this.mapHashPrefix = ""
      this.mapRenderer = ""
      this.mapToken = ""
    }
    this.showDiagnostics = true
    this.logText = "Map image display failed."
    var page = this
    var publish = function () {
      if (page.pendingPublication !== publication || page.lifecycleEpoch !== publication.epoch ||
        page.activeMapOperationID !== publication.operationID) return
      page.pendingPublication = null
      page.unconfirmedURI = ""
      page.unconfirmedTouched = false
      if (!page.releaseMapOperation(publication.operationID)) return
      page.sendRenderResult(publication, false, Date.now() - publication.renderStartedAt, "ASSET_RENDER")
      page.preparedRender = null
    }
    this.scheduleDelete(publication.uri, publish, publish)
  }
}
</script>

<style>
.page { width: 212px; height: 520px; background-color: #07162b; }
.waiting, .connected { width: 212px; height: 520px; padding-top: 54px; flex-direction: column; align-items: center; }
.connected { padding-top: 0; position: relative; }
.mark { width: 72px; height: 72px; border-radius: 18px; justify-content: center; align-items: center; background-color: #168cff; }
.mark-text { font-size: 46px; font-weight: bold; color: #ffffff; }
.title { margin-top: 18px; font-size: 25px; font-weight: bold; color: #ffffff; }
.status, .online { margin-top: 12px; font-size: 16px; font-weight: bold; color: #5dffb0; }
.detail { margin-top: 14px; width: 180px; height: 76px; font-size: 15px; lines: 4; text-align: center; color: #a9bdd6; }
.check, .button { margin-top: 24px; width: 184px; height: 52px; border-radius: 26px; font-size: 16px; color: #ffffff; background-color: #168cff; }
.version { margin-top: 22px; font-size: 13px; color: #7897b8; }
.nav-header { position: absolute; left: 14px; top: 12px; width: 184px; height: 124px; padding: 8px 12px; border-radius: 24px; background-color: rgba(4, 12, 20, 0.68); }
.nav-arrow { width: 72px; height: 72px; font-size: 62px; font-weight: bold; color: #00e5ff; }
.nav-distance { position: absolute; left: 82px; top: 12px; width: 120px; font-size: 32px; font-weight: bold; text-align: right; color: #ffffff; }
.nav-street { position: absolute; left: 12px; top: 78px; width: 160px; height: 42px; font-size: 18px; lines: 2; text-align: center; color: #ffffff; }
.nav-status { position: absolute; left: 12px; top: 108px; width: 160px; font-size: 12px; font-weight: bold; text-align: center; color: #5dffb0; }
.map-frame { width: 212px; height: 520px; position: relative; background-color: #050e16; }
.map { position: absolute; left: 0; top: 0; width: 212px; height: 520px; object-fit: contain; }
.nav-marker { position: absolute; width: 10px; height: 10px; border-width: 2px; border-color: #00e5ff; border-radius: 5px; background-color: #ffffff; }
.diagnostics { width: 212px; flex-direction: column; align-items: center; }
.log { margin-top: 14px; width: 184px; height: 260px; padding: 10px; font-size: 13px; lines: 12; color: #ffffff; background-color: #0d223d; }
.clear { margin-top: 10px; width: 184px; height: 40px; border-radius: 20px; font-size: 14px; color: #a9bdd6; background-color: #1f3652; }
</style>
